<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>
<body>
 <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li>
                    <i class="fa fa-reply"></i>
                    <a href="/processo/Triagem">  Retornar</a>
                </li>
                <li class="selected">
                    <i class="fa fa-folder"></i>
                    <a href="/processo/view_alta">  Baixa Prioridade</a>
                </li>
            </ul>

           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
               <a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Gerenciar Prioridades</h2>
               </div>
                <div class="panel-row">
                    <nav class ="nav_tabs">
                        <ul>
                            <li>
                                <input type="radio" name="tabs" class="rd_tabs" id="alta" >
                                <label onclick="window.location='/processo/view_alta/'" for ="alta">Alta Prioridade</label>

                            </li>

                            <li>
                                <input type="radio" name="tabs" class="rd_tabs" id="media">
                                <label onclick="window.location='/processo/view_media/'" for ="media">Média Prioridade</label>
                                
                            </li>
                            <li>
                                <input type="radio" name="tabs" class="rd_tabs" id="baixa" checked>
                                <label onclick="window.location='/processo/view_baixa/'" for ="baixa">Baixa Prioridade</label>
                                
                            </li>
                        </ul>
                    </nav>
                </div>
               <div class="dynamic-content">
                    <table class="table table-striped">                  
                        <thead>
                            <tr>
                                <th scope="col">Autor</th>
                                <th scope="col">Réu</th>
                                <th scope="col">Tutela</th>
                                <th scope="col">Data de Entrada</th>
                                <th scope="col">Prioridade</th>
                                <th scope="col">Editar</th>
                                <th scope="col">Excluir</th>
                            </tr>
                    </thead>
                    <tbody>
                    {{#each triagens}}

                            <tr>  
                                <td>{{Autor}}</td>
                                <td>{{Reu}}</td>
                                <td>{{Tutela}}</td>
                                <td>{{#formatDate Entrada}}{{/formatDate}}</td>
                                <td>{{Prioridade}}</td>
                                <td onclick="window.location='/processo/editTriagem/{{_id}}'"><i class="fas fa-edit"></i></td>
                                <td onclick="window.location='/processo/deletarTriagem/{{_id}}'"><i class="fas fa-trash-alt"></i></td>
                            </tr>
                    {{/each}}
                    </tbody>
                        
                    </table>

                </div>
       </main>
   </div>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>
