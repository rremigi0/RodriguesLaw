<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>
<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li>
                    <i class="fa fa-reply"></i>
                    <a href="/admin/home">  Retornar</a>
            
                </li>
                <li>
                    <i class="fas fa-plus"></i>
                    <a href="/cliente/add" data-toggle="modal" data-target="#clienteModal">  Novo</a>
                </li>

                <li class="selected">
                    <i class="fa fa-search"></i>
                    <a href="/cliente/view">  Consultar</a>
                </li>
                <li>
                    <i class="fa fa-gavel"></i>
                    <a href="/processo/triagem">  Petição Inicial</a>
                </li>
                <li>
                    <i class="far fa-calendar-alt"></i>
                    <a href="/audiencia/main">  Audiências</a>
                </li>

           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
               <a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Gerenciar Processos</h2>
               </div>
               <div class="panel-row">
                   <a href="/processo/triagem"><button class="panel panel-50" a-view="triagemInicial" onclick="fetchContent(this)" a-folder="processos">
                    <i class="fas fa-plus"></i>
                    Triagem Inicial
                    </button></a>
                   <a href="/processo/view_ativos"><button class="panel panel-50" a-view="visualizarProcessos" onclick="fetchContent(this)" a-folder="processos">
                    <i class="fas fa-table"></i>
                    Consultar Processos
                    </button></a>
               </div>
           </div>
       </main>
   </div>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/ajax.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>