<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>
<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li>
                    <i class="fas fa-home"></i>
                    <a href="/admin/dashboard">  Dashboard</a>
            
                </li>
                <li class="selected">
                    <i class="fas fa-user-tie"></i>
                    <a href="/admin/perfil">  Perfil</a>
                </li>
                <li>
                    <i class="fas fa-users"></i>
                    <a href="/admin/clientes">  Clientes</a>
                </li>
                <li>
                    <i class="fas fa-layer-group"></i>
                    <a href="/admin/processos">  Processos</a>
                </li>
                <li>
                    <i class="far fa-calendar-alt"></i>
                    <a href="/admin/audiencias">  Audiências</a>
                </li>
                <li>
                    <i class="far fa-newspaper"></i>
                    <a href="/admin/prazos">  Prazos</a>
                </li>
                <li>
                    <i class="fas fa-money-check-alt"></i>
                    <a href="/admin/financeiro">  Financeiro</a>
                </li>
                <li class="sidebar_logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <a href="/usuarios/logout">  Logout</a>
                </li>
            </ul>

           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
               <a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Gerenciar Prazos</h2>
               </div>
               <div class="panel-row">
                   
                   <a href="/admin/prazos/add"><button class="panel panel-50" a-view="cadastrarPrazos" onclick="fetchContent(this)" a-folder="prazos">
                    <i class="fas fa-plus"></i>
                    Cadastrar Prazos
                    </button></a>
                   <a href="/admin/prazos/view"><button class="panel panel-50" a-view="visualizarPrazos" onclick="fetchContent(this)" a-folder="prazos">
                    <i class="fas fa-table"></i>
                    Consultar Prazos
                    </button></a>
               </div>
               <div class="dynamic-content">
                   <div class="card-body"></div>
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}
                  <form action="/admin/prazos/edit" method="POST">
                      <input type="hidden" name="id" value="{{prazo._id}}">
                    <div class="form-group">
                      <label for="processo">Processo</label>
                      <input type="text" class="form-control" id="processo" aria-describedby="emailHelp" name="processo" value="{{prazo.Processo}}">
                    </div>
                    <div class="form-group">
                        <label for="autor">Autor</label>
                        <input type="text" class="form-control" id="autor" name="autor" value="{{prazo.Autor}}">
                    </div>
                    <div class="form-group">
                        <label for="reu">Réu</label>
                        <input type="text" class="form-control" id="reu" name="reu" value="{{prazo.Reu}}">
                    </div>
                    <div class="form-group">
                        <label for="procedimento">Procedimento</label>
                        <input type="text" class="form-control" id="procedimento" name="procedimento" value="{{prazo.Procedimento}}">
                    </div>
                    <div class="form-group">
                        <label for="peticao">Petição Processual</label>
                        <input type="text" class="form-control" id="peticao" name="peticao" value="{{prazo.Peticao}}">
                    </div>
                    <div class="form-group">
                        <label for="publicacao">Publicação</label>
                        <input type="date" class="form-control" id="publicacao" name="publicacao" value="{{prazo.Publicacao}}">
                    </div>
                    <div class="form-group">
                        <label for="prazo">Prazo</label>
                        <input type="date" class="form-control" id="prazo" name="prazo" value="{{prazo.Prazo}}">
                    </div>
                    <button type="submit" class="btn">Salvar</button>
                     
                  </form>
            </div>
       </main>
   </div>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/ajax.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>

