 <div class="flex-dashboard">
    {{> menu/processo/main}}
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
           </header>
           <div class="sub-menu">

               {{> menu/processo/submenu}}

           </div>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Gerenciar Prioridades</h2>
               </div>
                <div class="panel-row">
                    <nav class ="nav_tabs">
                        <ul>
                            <li>
                                <input type="radio" name="tabs" class="rd_tabs" id="iniciacao" checked>
                                <label onclick="window.location='/processo/triagem/iniciacao/'" for ="iniciacao">Iniciação</label>
                            </li>
                            <li>
                                <input type="radio" name="tabs" class="rd_tabs" id="redacao">
                                <label onclick="window.location='/processo/triagem/redacao/'" for ="redacao">Redação</label>                               
                            </li>
                            <li>
                                <input type="radio" name="tabs" class="rd_tabs" id="validacao">
                                <label onclick="window.location='/processo/triagem/validacao/'" for ="validacao">Validação</label>         
                            </li>
                            <li>
                                <input type="radio" name="tabs" class="rd_tabs" id="protocolados">
                                <label onclick="window.location='/processo/triagem/protocolados/'" for ="protocolados">Protocolados</label> 
                            </li>
                        </ul>
                    </nav>
                </div>
               <div class="dynamic-content">
                    <table class="table table-striped">                  
                        <thead>
                            <tr>
                                <th scope="col">Autor</th>
                                <th scope="col">Réu</th>
                                <th scope="col">Tutela</th>
                                <th scope="col">Data de Entrada</th>
                                <th scope="col">Prioridade</th>
                                <th scope="col">Detalhes</th>
                                <th scope="col">Excluir</th>
                                <th scope="col">Drive</th>
                            </tr>
                    </thead>
                    <tbody>
                    {{#each triagens}}

                            <tr>  
                                <td>{{Autor}}</td>
                                <td>{{Reu}}</td>
                                <td>{{Tutela}}</td>
                                <td>{{#formatDate Entrada}}{{/formatDate}}</td>
                                <td>{{Prioridade}}</td>
                                <td onclick="window.location='/processo/triagem/detail/{{_id}}'"><i class="fa fa-search" style="color: #6e8efb; font-size: 16px; "></i></td>
                                <td onclick="window.location='/processo/deletarTriagem/{{_id}}'"><i class="fas fa-trash-alt" style="color: #6e8efb; font-size: 16px; "></i></td>
                                <td><a href="{{Drive}}"><i class="fab fa-google-drive" style="color: #6e8efb; font-size: 16px; "></i></a></td>
                            </tr>
                    {{/each}}
                    </tbody>    
                    </table>
                </div>
       </main>
   </div>
</body>
</html>
