<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>

<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li><i class="fa fa-reply"></i><a href="/processo/ativos">  Retornar</a></li>
                <li><i class="fas fa-plus"></i><a href="/processo/addTriagem"data-toggle="modal" data-target="#processoModal">  Novo</a></li>
                <li><i class="fa fa-search"></i><a href="/processo/triagem/iniciacao">  Consultar</a></li>
            </ul>
           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
               <a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="sub-menu">

                {{> menu/processo/submenu}}

            </div>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Petição Inicial</h2>
               </div>
           </div>
       </main>
<!-- Cadastro de Processos (Modal Novo Processo) -->

    <div class="modal fade" id="processoModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="dynamic-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cadastrar Petição Inicial</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>      
                    </div>        
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}
                        <form action="/processo/add/addTriagem" method="POST">
                    <div class="form-group">
                      <label for="cliente">Cliente</label>
                            <select name="cliente" class="custom-select">
                                {{#each clientes}}
                                    <option value="{{_id}}">{{Nome}}</option>
                                {{else}}
                                    <option value="">Nenhum Cliente Registrado</option>
                                {{/each}}
                            </select>
                      <label for="autor">Autor</label><input type="text" class="form-control" id="autor" name="autor">
                      <label for="reu">Réu</label><input type="text" class="form-control" id="reu" name="reu">

                      <label for="tutela">Tutela</label>
                        <select class="form-control" id="tutela" name="tutela">
                            <option>Sim</option>
                            <option>Não</option>
                        </select>
                      <label for="entrada">Data de Entrada</label><input type="date" class="form-control" id="entrada" name="entrada">
                      <label for="prioridade">Prioridade</label>
                        <select class="form-control" id="prioridade" name="prioridade">
                            <option>Verde</option>
                            <option>Amarelo</option>
                            <option>Vermelho</option>
                        </select>
                    </div>
                    
                    <button type="submit" class="btn">Cadastrar</button>
                  </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
   </div>
   </div>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>