<!DOCTYPE html>
<html lang="pt-br">
    
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>

<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li><i class="fas fa-home"></i><a href="/admin/home">  Home</a></li>
                <li><i class="fa fa-reply"></i><a href="/cliente/view">  Retornar</a></li>
                <li class="selected"><i class="fa fa-search"></i><a href="/cliente/detail">  Detalhes</a></li>
                <li><i class="fa fa-plus"></i><a href="/movimentacao/add" data-toggle="modal" data-target="#movimentacaoModal">  Movimentações</a></li>
            </ul>
           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i><a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Processo:</h2>
               </div>
               <div class="dynamic-content-edit">
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}

<!-- Menu de Navegação de Cadastro de Clientes -->
                 <form action="/processo/edit" method="POST">
                      <input type="hidden" name="id" value="{{processo._id}}">
                            <nav>
                            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                <a class="nav-item nav-link active" id="nav-geral-tab" data-toggle="tab" href="#nav-geral" role="tab" aria-controls="nav-geral" aria-selected="true">Geral</a>
                                <a class="nav-item nav-link" id="nav-dados-tab" data-toggle="tab" href="#nav-dados" role="tab" aria-controls="nav-dados" aria-selected="false">Dados</a>
                                <a class="nav-item nav-link" id="nav-audiencia-tab" data-toggle="tab" href="#nav-audiencia" role="tab" aria-controls="nav-audiencia" aria-selected="false">Audiência</a>
                                <a class="nav-item nav-link" id="nav-julgador-tab" data-toggle="tab" href="#nav-julgador" role="tab" aria-controls="nav-julgador" aria-selected="false">Órgão Julgador</a>
                                <a class="nav-item nav-link" id="nav-movimentacoes-tab" data-toggle="tab" href="#nav-movimentacoes" role="tab" aria-controls="nav-movimentacoes" aria-selected="false">Movimentações</a>
                                <a class="nav-item nav-link" id="nav-status-tab" data-toggle="tab" href="#nav-status" role="tab" aria-controls="nav-status" aria-selected="false">Status</a>
                            </div>
                            </nav>

<!-- Aba Navegação Geral do Detalhe do Processo -->

                        <div class="tab-content" id="nav-tabContent">
                            <div class="tab-pane fade show active" id="nav-geral" role="tabpanel" aria-labelledby="nav-geral-tab">
                                <div class="card-body">
                                    <div class="form-row">
                                      <div class="col-md-4 mb-4">
                                        <label for="processo">Número</label><input type="text" class="form-control" id="processo" aria-describedby="emailHelp" name="processo" value="{{processo.Processo}}">
                                      </div>
                                      <div class="col-md-6 mb-6">
                                        <label for="autor">Autor</label><input type="text" class="form-control" id="autor" name="autor" value="{{processo.Autor}}">
                                      </div>
                                      <div class="col-md-6 mb-6">
                                        <label for="reu">Réu</label><input type="text" class="form-control" id="reu" name="reu" value="{{processo.Reu}}">
                                      </div>                                        
                                    </div>
                                </div>
                            </div>

<!-- Aba Navegação Dados -->

                        <div class="tab-pane fade" id="nav-dados" role="tabpanel" aria-labelledby="nav-dados">
                                <div class="card-body">
                                    <div class="form row">
                                        <div class="col-md-9 mb-9">
                                            <label for="procedimento">Procedimento</label><input type="text" class="form-control" id="procedimento" aria-describedby="emailHelp" name="procedimento" value="{{processo.Procedimento}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="tutela">Tutela?</label><input type="text" class="form-control" id="tutela" aria-describedby="emailHelp" name="tutela" value="{{processo.Tutela}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="categoria">Categoria</label><input type="text" class="form-control" id="categoria" aria-describedby="emailHelp" name="categoria" value="{{processo.Categoria}}">
                                        </div>
                                        <div class="col-md-4 mb-4">
                                            <label for="classe">Classe</label><input type="text" class="form-control" id="classe" aria-describedby="emailHelp" name="classe" value="{{processo.Classe}}">
                                        </div>
                                        <div class="col-md-4 mb-4">
                                            <label for="assunto">Assunto</label><input type="text" class="form-control" id="assunto" aria-describedby="emailHelp" name="assunto" value="{{processo.Assunto}}">
                                        </div>
                                    </div>
                                </div>
                            </div>

<!-- Aba Navegação Audiência -->

                            <div class="tab-pane fade" id="nav-audiencia" role="tabpanel" aria-labelledby="nav-audiencia">
                                <div class="card-body">
                                    <div class="form row">
                                        <div class="col-md-4 mb-4">
                                            <label for="audiencia">Audiencia</label><input type="datetime-local" class="form-control" id="audiencia" name="audiencia" value="{{#formatDateTime processo.Audiencia}}{{/formatDateTime}}">
                                        </div>
                                    </div>
                                </div>
                            </div>

<!-- Aba Navegação Órgão Julgador -->

                            <div class="tab-pane fade" id="nav-julgador" role="tabpanel" aria-labelledby="nav-julgador">
                                <div class="card-body">
                                    <div class="form row">
                                        <div class="col-md-3 mb-3">
                                            <label for="secao">Seção</label><input type="text" class="form-control" id="secao" name="secao" value="{{processo.Secao}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="vara">Vara</label><input type="text" class="form-control" id="vara" name="vara" value="{{processo.Vara}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="comarca">Comarca</label><input type="text" class="form-control" id="comarca" name="comarca" value="{{processo.Comarca}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="uf">UF</label><input type="text" class="form-control" id="uf" name="uf" value="{{processo.UF}}">
                                        </div>
                                    </div>
                                </div>
                            </div>

<!-- Aba Navegação Movimentação -->

            <div class="tab-pane fade" id="nav-movimentacoes" role="tabpanel" aria-labelledby="nav-movimentacoes">
                {{#each erros}}
                <div class="alert alert-danger">{{texto}}</div>
                {{else}}
                {{/each}}
                    <table id="tabela" class="table table-striped table-bordered" style="width:100%; margin-top: 15px">
                        <thead>
                            <tr>                            
                                <th scope="col">Data</th>
                                <th scope="col">Movimento</th>
                                <th scope="col">Enviado Push?</th>
                            </tr>        
                        </thead>
                        <tbody>
                        {{#each processo.Movimentacao}}
                            <tr>  
                                <td>{{#formatDate Data}}{{/formatDate}}</td>
                                <td>{{Movimento}}</td>
                                <td>{{Push}}</td>
                            </tr>
                        {{/each}}
                        </tbody>
                    </table>
            </div>

<!-- Aba Navegação Status -->

                            <div class="tab-pane fade" id="nav-status" role="tabpanel" aria-labelledby="nav-status">
                                <div class="card-body">
                                    <div class="form row">
                                        <div class="col-md-3 mb-3">
                                            <label for="atuacao">Atuação</label><input type="date" class="form-control" id="atuacao" name="atuacao" value="{{#formatDateUS processo.Atuacao}}{{/formatDateUS}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="distribuicao">Distribuicao</label><input type="date" class="form-control" id="distribuicao" name="distribuicao" value="{{#formatDateUS processo.Distribuicao}}{{/formatDateUS}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="status">Status</label><input type="text" class="form-control" id="status" name="status" value="{{processo.Status}}">
                                        </div>
                                        <div class="col-lg-12" style="text-align: right">
                                            <button type="submit" class="btn btn-success">Atualizar</button>
                                        </div>                        
                                    </div>
                                </div>                     
                            </div>
                        </form>                        
                    </div>
                </div>
            </div>

<!-- FINANCEIRO -->

        <div class="main-content-title">
            <br><h2>FINANCEIRO</h2>
        </div>
            <div class="dynamic-content-edit">
                <div class="card-body">
                    {{#each erros}}
                        <div class="alert alert-danger">{{texto}}</div>
                    {{else}}
                    {{/each}}
                <table id="tabela" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>                            
                            <th scope="col">Tipo</th>
                            <th scope="col">Vencimento</th>
                            <th scope="col">Honorários</th>
                            <th scope="col">Status</th>
                            <th scope="col">Atualizar</th>
                            <th scope="col">Excluir</th>
                        </tr>        
                    </thead>
                    <tbody>
                        {{#each processo.Financeiro}}
                        <tr>  
                            <td>{{Tipo}}</td>
                            <td>{{#formatDate Vencimento}}{{/formatDate}}</td>
                            <td>{{Honorarios}}</td>
                            <td>{{Status}}</td>
                            <td onclick0="window.location='/processo/detail/{{_id}}'"><i class="fa fa-search" style="color: grey; font-size: 20px;"></i></td>
                            <td onclick="window.location='/financeiro/deletar/{{_id}}'"><i class="fas fa-trash-alt" style="color: #6e8efb; font-size: 18px; "></i></td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
                    <div class="button-new" style="text-align: right">
                        <button type="submit" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#financeiroModal"><i class="fas fa-plus"></i><a href="/processo/triagem"></a></button>
                    </div>
                </div>
            </div>

   <!-- Cadastro de Novo Honorário (Modal Novo Honorários) -->

    <div class="modal fade" id="financeiroModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="dynamic-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cadastrar Honorários</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>      
                    </div>        
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}

    <!-- Aba Navegação Geral do Novo Honorário -->

                    <form action="/financeiro/add/addFinanceiro" method="POST">
                        <div class="form-group">
                            <label for="processo">Código do Processo (Não alterar)</label><input type="text" class="form-control" id="processo" name="processo" value="{{processo.id}}">
                            <label for="autor">Autor</label><input type="text" class="form-control" id="autor" name="autor">
                            <label for="reu">Réu</label><input type="text" class="form-control" id="reu" name="reu">
                            <label for="competencia">Competencia</label><input type="text" class="form-control" id="competencia" name="competencia">
                            <label for="tipo">Tipo</label><input type="text" class="form-control" id="tipo" name="tipo">
                            <label for="vencimento">Vencimento</label><input type="date" class="form-control" id="vencimento" name="vencimento">
                            <label for="honorarios">Honorario</label><input type="text" class="form-control" id="honorarios" name="honorarios">
                            <label for="status">Status</label><input type="text" class="form-control" id="status" name="status">
                        </div>
                            <button type="submit" class="btn">Salvar</button>
                        </div>
                    </form>         
                </div>
            </div>
        </div>
    </div>

    <!-- ATIVIDADES -->

        <div class="main-content-title">
            <br><h2>ATIVIDADES</h2>
        </div>
            <div class="dynamic-content-edit">
                <div class="card-body">
                    {{#each erros}}
                        <div class="alert alert-danger">{{texto}}</div>
                    {{else}}
                    {{/each}}
                <table id="tabela" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>                            
                            <th scope="col">Autor</th>
                            <th scope="col">Reu</th>
                            <th scope="col">Peticao</th>
                            <th scope="col">Publicacao</th>
                            <th scope="col">Prazo</th>
                            <th scope="col">Atualizar</th>
                        </tr>        
                    </thead>
                    <tbody>
                        {{#each processo.Prazos}}
                        <tr>  
                            <td>{{Autor}}</td>
                            <td>{{Reu}}</td>
                            <td>{{Peticao}}</td>
                            <td>{{#formatDate Publicacao}}{{/formatDate}}</td>
                            <td>{{#formatDate Prazo}}{{/formatDate}}</td>
                            <td onclick="window.location='/prazo/atualizar/{{_id}}'"><i class="fas fa-sync-alt" style="color: #6e8efb; font-size: 20px;"></i></td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
                    <div class="button-new" style="text-align: right">
                        <button type="submit" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#prazoModal"><i class="fas fa-plus"></i></button>
                    </div>
                </div>
            </div>

 <!-- Modal para Cadastrar Novo Prazo -->

    <div class="modal fade" id="prazoModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="dynamic-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cadastrar Prazo</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>      
                    </div>        
                    <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}
                    <form action="/prazo/add/addPrazos" method="POST">
                        <div class="form-group">
                            <label for="processo">Código do Processo (Não alterar)</label><input type="text" class="form-control" id="processo" name="processo" value="{{processo.id}}">
                            <label for="numero">Número do Processo</label><input type="text" class="form-control" id="numero" name="numero" value="{{processo.Processo}}">
                            <label for="autor">Autor</label><input type="text" class="form-control" id="autor" name="autor" value="{{processo.Autor}}">
                            <label for="reu">Réu</label><input type="text" class="form-control" id="reu" name="reu" value="{{processo.Reu}}">
                            <label for="procedimento">Procedimento</label><input type="text" class="form-control" id="procedimento" name="procedimento" value="{{processo.Procedimento}}">
                            <label for="peticao">Petição Processual</label><input type="text" class="form-control" id="peticao" name="peticao">
                            <label for="publicacao">Publicação</label><input type="date" class="form-control" id="publicacao" name="publicacao">
                            <label for="prazo">Prazo</label><input type="date" class="form-control" id="prazo" name="prazo">
                            <label for="status">Status</label>
                            <select class="form-control" id="status" name="status">
                                <option>Pendente</option>
                            </select>
                        </div>
                            <button type="submit" class="btn">Salvar</button>
                    </form>         
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- Modal Cadastrar Nova Movimentação -->

    <div class="modal fade" id="movimentacaoModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="dynamic-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cadastrar Movimentação</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>      
                    </div>        
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}

 <!-- Aba Navegação Geral do Nova Movimentacao -->

                    <form action="/movimentacao/add" method="POST">
                        <div class="form-group">
                            <label for="processo">Código do Processo (Não alterar)</label><input type="text" class="form-control" id="processo" name="processo" value="{{processo.id}}">
                            <label for="data">Data</label><input type="date" class="form-control" id="data" name="data">
                            <label for="movimento">Movimentação</label><input type="text" class="form-control" id="movimento" name="movimento">
                            <label for="push">Enviado Push?</label>
                                <select class="form-control" id="push" name="push">
                                    <option>Sim</option>
                                    <option>Não</option>
                                </select>
                        </div>
                            <button type="submit" class="btn">Salvar</button>
                    </form>         
                    </div>
                </div>
            </div>
        </div>
    </div>