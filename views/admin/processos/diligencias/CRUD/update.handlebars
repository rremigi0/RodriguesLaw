 <div class="flex-dashboard">
    {{> menu/processo/main}}
       
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
           </header>
           <div class="sub-menu">

               {{> menu/processo/submenu}}

           </div>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Gerenciar Diligências</h2>
               </div>
               <div class="dynamic-content">
                   <div class="card-body"></div>
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}
                  <form action="/diligencia/atualizar" method="POST">
                      <input type="hidden" name="id" value="{{diligencia._id}}">
                    <div class="form-group">
                      <label for="processo">Código do Cliente (Não alterar)</label>
                      <input type="text" class="form-control" id="processo" aria-describedby="emailHelp" name="processo" value="{{diligencia.Processo}}">
                    </div>
                        <label for="status">Status</label>
                            <select class="form-control" type="text" id="status" name="status" value="{{diligencia.Status}}">
                                <option>Pendente</option>
                                <option>Validacao</option>
                                <option>Error</option>
                                <option>Finalizado</option>
                            </select><br>
                    <button type="submit" class="btn">Salvar</button>
                     
                  </form>
            </div>
       </main>
   </div>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>

