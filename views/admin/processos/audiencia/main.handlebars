 <div class="flex-dashboard">
    {{> menu/processo/main}}
       
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
           </header>
           <div class="sub-menu">

               {{> menu/processo/submenu}}

           </div>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Controle de Audiência</h2>
               </div>
               <div class="dynamic-content">

                   <table class="table table-striped">                  
                            <thead>
                            <tr>
                                <th scope="col">Processo</th>
                                <th scope="col">Autor</th>
                                <th scope="col">Réu</th>
                                <th scope="col">Audiência</th>
                                <th scope="col">Horário</th>
                                <th scope="col">Editar</th>
                            </tr>
                        </thead>
                    <tbody>
                       {{#each processos}}

                            <tr>  
                                <td>{{Processo}}</td>
                                <td>{{Autor}}</td>
                                <td>{{Reu}}</td>
                                <td>{{#formatDate Audiencia}}{{/formatDate}}</td>
                                <td>{{#formatTime Audiencia}}{{/formatTime}}</td>
                                <td onclick="window.location='/audiencia/edit/{{_id}}'"><i class="fas fa-edit" style="color: #6e8efb; font-size: 16px; "></i></td>
                            </tr>
                        {{/each}}
                    </tbody>
                        
                    </table>
                </div>
       </main>
   </div>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>
