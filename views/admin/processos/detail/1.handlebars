<div class="flex-dashboard">
    {{> menu/processo/detail}}
        <main id="mainContent">
            <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i><a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
            </header>
                        {{> formulario/processo}}
                        {{> tabelas/financeiro}}    
                            {{> modal/financeiro/add}}
                        

    <!-- ATIVIDADES -->
                    
                    <div class="main-content-title">
                        <br><h2>ATIVIDADES:</h2>
                    </div>

                    <div class="dynamic-content-edit">
                        <div class="card-body">
                            {{#each erros}}
                                <div class="alert alert-danger">{{texto}}</div>
                            {{else}}
                            {{/each}}
                            {{> tabelas/prazos}}
                                {{> modal/prazo/add}}
                            {{> tabelas/diligencias}}
                                {{> modal/processo/diligencias/add}}
                            {{> tabelas/push}}
                                {{> modal/processo/movimentacoes/add}} 
                        </div>
                    </div>
        </main>
</div>
 




