<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>
<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
            <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li>
                    <i class="fas fa-home"></i>
                    <a href="/admin/dashboard">  Dashboard</a>
            
                </li>
                <li class="selected">
                    <i class="fas fa-user-tie"></i>
                    <a href="/admin/perfil">  Perfil</a>
                </li>
                <li>
                    <i class="fas fa-plus"></i>
                    <a href="/admin/cadastro">  Cadastro</a>
                </li>
                <li>
                    <i class="fas fa-users"></i>
                    <a href="/cliente/main">  Clientes</a>
                </li>
                <li>
                    <i class="fas fa-layer-group"></i>
                    <a href="/processo/main">  Processos</a>
                </li>
                <li>
                    <i class="far fa-calendar-alt"></i>
                    <a href="/audiencia/main">  Audiências</a>
                </li>
                <li>
                    <i class="far fa-newspaper"></i>
                    <a href="/prazo/main">  Prazos</a>
                </li>
                <li>
                    <i class="fas fa-money-check-alt"></i>
                    <a href="/financeiro/main">  Financeiro</a>
                </li>
                <li>
                    <i class="fas fa-cog"></i>
                    <a href="/admin/Configuracoes">  Configurações</a>
                </li>
                <li class="sidebar_logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <a href="/usuarios/logout">  Logout</a>
                </li>
            </ul>

           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
               <a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>PERFIL</h2>
               </div>
               <div class="perfil-parent">
                   <div class="perfil">
                       <div class="perfil-img">
                           <div class="img"></div>
                       </div>
                           <div class="perfil-form">
                            <form>
                                <div class="form-group">
                                  <label for="name">Nome Completo</label>
                                  <input type="text" class="form-control" id="name" placeholder="Nome Completo">
                                </div>
                                <div class="form-group">
                                  <label for="email">Email</label>
                                  <input type="email" class="form-control" id="email" placeholder="Email">
                                </div>
                                <div class="form-group">
                                    <label for="function">Cargo/Função</label>
                                    <select class="form-control" id="function">
                                      <option>Advogado(a)</option>
                                      <option>Cliente</option>
                                      <option>Estagiário(a)</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="genre">Gênero</label>
                                    <select class="form-control" id="genre">
                                      <option>Masculino</option>
                                      <option>Feminino</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                  <label for="password">Senha</label>
                                  <input type="password" class="form-control" id="password" placeholder="Senha">
                                </div>
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="customFile">
                                    <label class="custom-file-label" for="customFile">Choose file</label>
                                </div>
                                <button type="submite" class="btn">Salvar</button>
                              </form>

                           </div>
                           
                       </div>
                   </div>
               </div>
               
           </div>
           
       </main>
   </div>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>