 <div class="flex-dashboard">
     {{> menu/administrativo/main}}
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
           </header>
           <div class="sub-menu">

               {{> menu/administrativo/submenu}}

           </div>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Gerenciar Acesso de Usuários</h2>
               </div>
               <div class="dynamic-content-edit">
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}

<!-- Menu de Navegação de Cadastro de Usuarios -->
                 <form action="/usuarios/edit" method="POST">
                      <input type="hidden" name="id" value="{{usuario._id}}">
                            <nav>
                            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                <a class="nav-item nav-link active" id="nav-geral-tab" data-toggle="tab" href="#nav-geral" role="tab" aria-controls="nav-geral" aria-selected="true">Geral</a>
                                <a class="nav-item nav-link" id="nav-nivel-tab" data-toggle="tab" href="#nav-nivel" role="tab" aria-controls="nav-nivel" aria-selected="false">Nível</a>
                            </div>
                            </nav>

<!-- Aba Navegação Geral do Cadastro de Usuarios -->

                        <div class="tab-content" id="nav-tabContent">
                            <div class="tab-pane fade show active" id="nav-geral" role="tabpanel" aria-labelledby="nav-geral-tab">
                                <div class="card-body">
                                    <div class="form-row">
                                        <div class="col-md-6 mb-6">
                                            <label for="nome">Nome</label><input type="text" class="form-control" id="nome" name="nome" value="{{usuario.nome}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="Cpf_Cnpj">CPF</label><input type="text" class="form-control" id="Cpf_Cnpj"  name="Cpf_Cnpj" value="{{usuario.Cpf_Cnpj}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="genero">Gênero</label><input type="text" class="form-control" id="genero"  name="genero" value="{{usuario.genero}}">
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="col-md-6 mb-6">
                                            <label for="email">Email</label><input type="email" class="form-control" id="email"  name="email" value="{{usuario.email}}">
                                        </div>
                                    </div>
                                </div>
                            </div>

<!-- Aba Navegação Nível do Cadastro de Usuarios -->

                            <div class="tab-pane fade" id="nav-nivel" role="tabpanel" aria-labelledby="nav-nivel-tab">
                                <div class="card-body">
                                    <div class="form-row">
                                       <div class="col-md-6 mb-6">
                                            <label for="eAdmin">Nível</label><input type="text" class="form-control" id="eAdmin" name="eAdmin" value="{{usuario.eAdmin}}">
                                        </div><br> 
                                        <div class="col-lg-12" style="text-align: right">
                                            <button type="submit" class="btn btn-success">Atualizar</button>
                                        </div> 
                                    </div>
                                </div>
                            </div>
                        </div>  
                    </form>
                </div>
            </div>
        </div>
    </main>
</div> 
</body>
</html>

