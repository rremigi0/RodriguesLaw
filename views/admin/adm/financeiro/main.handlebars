 <div class="flex-dashboard">
     {{> menu/administrativo/main}}
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
           </header>
           <div class="sub-menu">

               {{> menu/administrativo/submenu}}

           </div>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Controle Financeiro</h2>
               </div>
               <div class="dynamic-content">

                   <table class="table table-striped">                  
                            <thead>
                            <tr>
                                <th scope="col">Processo</th>
                                <th scope="col">Competência</th>
                                <th scope="col">Tipo</th>
                                <th scope="col">Vencimento</th>
                                <th scope="col">Honorários</th>
                                <th scope="col">Status</th>
                                <th scope="col">Detalhes</th>
                                <th scope="col">Excluir</th>
                            </tr>
                        </thead>
                    <tbody>
                       {{#each financeiro}}

                            <tr>    
                                <td>{{Processo.Processo}}</td>
                                <td>{{Competencia}}</td>
                                <td>{{Tipo}}</td>
                                <td>{{#formatDate Vencimento}}{{/formatDate}}</td>
                                <td>{{Honorarios}}</td>
                                <td>{{Status}}</td>
                                <td onclick="window.location='/financeiro/edit/{{_id}}'"><i class="fa fa-search" style="color: #6e8efb; font-size: 18px; "></i></td>
                                <td onclick="window.location='/financeiro/deletar/{{_id}}'"><i class="fas fa-trash-alt" style="color: #6e8efb; font-size: 18px; "</i></td>
                            </tr>
                        {{/each}}
                    </tbody>
                        
                    </table>
                    </form>
                </div>
           </div>
       </main>
   </div>
</body>
</html>