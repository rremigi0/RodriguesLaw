<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>
<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li>
                    <i class="fa fa-reply"></i>
                    <a href="/admin/administrativo">  Retornar</a>
            
                </li>
                <li>
                    <i class="fas fa-plus"></i>
                    <a href="/financeiro/add" data-toggle="modal" data-target="#financeiroModal">  Novo</a>
                </li>
                <li class="selected">
                    <i class="fa fa-search"></i>
                    <a href="/financeiro/view">  Consultar</a>
                </li>
            </ul>

           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
               <a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Controle de Honorários</h2>
               </div>
               <div class="dynamic-content">

                   <table class="table table-striped">                  
                            <thead>
                            <tr>
                                <th scope="col">Processo</th>
                                <th scope="col">Autor</th>
                                <th scope="col">Réu</th>
                                <th scope="col">Competência</th>
                                <th scope="col">Tipo</th>
                                <th scope="col">Vencimento</th>
                                <th scope="col">Honorários</th>
                                <th scope="col">Status</th>
                                <th scope="col">Editar</th>
                                <th scope="col">Excluir</th>
                            </tr>
                        </thead>
                    <tbody>
                       {{#each financeiro}}

                            <tr>    
                                <td>{{Processo}}</td>
                                <td>{{Autor}}</td>
                                <td>{{Reu}}</td>
                                <td>{{Competencia}}</td>
                                <td>{{Tipo}}</td>
                                <td>{{#formatDate Vencimento}}{{/formatDate}}</td>
                                <td>{{Honorarios}}</td>
                                <td>{{Status}}</td>
                                <td onclick="window.location='/financeiro/edit/{{_id}}'"><i class="fas fa-edit"></i></td>
                                <td onclick="window.location='/financeiro/deletar/{{_id}}'"><i class="fas fa-trash-alt"></i></td>
                            </tr>
                        {{/each}}
                    </tbody>
                        
                    </table>
                    </form>
                </div>
       </main>
<!-- Cadastro de Honorários (Modal Novo Honorários) -->

    <div class="modal fade" id="financeiroModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="dynamic-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cadastrar Honorários</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>      
                    </div>        
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}
                  <form action="/financeiro/add/addFinanceiro" method="POST">
                    <div class="form-group">
                      <label for="processo">Processo</label>
                      <input type="text" class="form-control" id="processo" aria-describedby="emailHelp" name="processo">
                    </div>
                    <div class="form-group">
                        <label for="autor">Autor</label>
                        <input type="text" class="form-control" id="autor" name="autor">
                    </div>
                    <div class="form-group">
                        <label for="reu">Réu</label>
                        <input type="text" class="form-control" id="reu" name="reu">
                    </div>
                    <div class="form-group">
                        <label for="competencia">Competencia</label>
                        <input type="text" class="form-control" id="competencia" name="competencia">
                    </div>
                    <div class="form-group">
                        <label for="tipo">Tipo</label>
                        <input type="text" class="form-control" id="tipo" name="tipo">
                    </div>
                    <div class="form-group">
                        <label for="vencimento">Vencimento</label>
                        <input type="date" class="form-control" id="vencimento" name="vencimento">
                    </div>
                    <div class="form-group">
                        <label for="honorarios">Honorario</label>
                        <input type="text" class="form-control" id="honorarios" name="honorarios">
                    </div>
                    <div class="form-group">
                        <label for="status">Status</label>
                        <input type="text" class="form-control" id="status" name="status">
                    </div>
                    <button type="submit" class="btn">Cadastrar</button>
                  </form>
                

    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>



