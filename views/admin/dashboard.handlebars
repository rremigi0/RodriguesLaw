<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>
<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li class="selected">
                    <i class="fas fa-home"></i>
                    <a href="/admin/dashboard">  Dashboard</a>
            
                </li>
                <li>
                    <i class="fas fa-user-tie"></i>
                    <a href="/admin/perfil">  Perfil</a>
                </li>
                <li>
                    <i class="fas fa-users"></i>
                    <a href="/admin/clientes">  Clientes</a>
                </li>
                <li>
                    <i class="fas fa-layer-group"></i>
                    <a href="/admin/processos">  Processos</a>
                </li>
                <li>
                    <i class="far fa-calendar-alt"></i>
                    <a href="/admin/audiencias">  Audiências</a>
                </li>
                <li>
                    <i class="far fa-newspaper"></i>
                    <a href="/admin/prazos">  Prazos</a>
                </li>
                <li>
                    <i class="fas fa-money-check-alt"></i>
                    <a href="/admin/financeiro">  Financeiro</a>
                </li>
                <li class="sidebar_logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <a href="/usuarios/logout">  Logout</a>
                </li>
            </ul>

           </div>
       </sidebar>
       <main id="mainContent">
           <header>
               <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
               <a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                    <h2>DASHBOARD</h2> 
                </div> 
                <div class="dashboard-content">
                    <div class="dashboard-flex-parent">
                        <div class="dashboard-box">
                            <div class="dashboard-box-wrapper">  
                                <div class="box-icon box-prazos">
                                    <i class="far fa-newspaper"></i>
                                </div>
                                <div class="value">0005</div>
                                <div class="type">PRAZOS</div>
                                <div class="box-value-percentual box-value-prazos">
                                    <i class="fas fa-sort-up"></i>   
                                    10% 
                                </div>
                            </div>               
                        </div>
                        <div class="dashboard-box">
                            <div class="dashboard-box-wrapper">
                                <div class="box-icon box-audiencias">
                                    <i class="far fa-calendar-alt"></i>
                                </div>
                                <div class="value">0009</div>
                                <div class="type">AUDIÊNCIAS</div>   
                                <div class="box-value-percentual box-value-audiencias">
                                    <i class="fas fa-sort-up"></i>   
                                10% 
                                </div>                
                            </div>
                        </div>
                        <div class="dashboard-box">
                            <div class="dashboard-box-wrapper">
                                <div class="box-icon box-processos">
                                    <i class="fas fa-layer-group"></i>
                                </div>
                                <div class="value">0015</div>
                                <div class="type">PROCESSOS PENDENTES</div> 
                                <div class="box-value-percentual box-value-processos">
                                    <i class="fas fa-sort-up"></i>   
                                10% 
                                </div>                  
                            </div>
                        </div>
                        <div class="dashboard-box">
                            <div class="dashboard-box-wrapper">
                                <div class="box-icon box-clientes">
                                    <i class="fas fa-users"></i>
                                </div>
                                <div class="value">0009</div>
                                <div class="type">NOVOS CLIENTES</div>
                                <div class="box-value-percentual box-value-clientes">
                                    <i class="fas fa-sort-up"></i>   
                                10% 
                                </div>                   
                            </div>
                        </div>
                    </div>         
                </div>
           </div>
       </main>
   </div>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>