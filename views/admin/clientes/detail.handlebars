   <div class="flex-dashboard">
      
       {{> menu/clientes/detail}}
       
       <main id="mainContent">          
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i><a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
                <div class="main-content-title">
                   <h2>DADOS CADASTRAIS:</h2>
                </div>
               
               <div class="dynamic-content-edit">
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}

                    <div class="button-pdf">
                        <i class="fa fa-file-pdf" data-toggle="modal" data-target="#pdfModal"></i><a href="/processo/triagem"></a>
                    </div> 

                     
                    {{> formulario/edit}}
                    
                    {{> tabelas/triagens}}


                    {{> modal/processo/triagem/add}}
                    {{> modal/processo/add}}
                    {{> modal/cliente/pdf}}

                    {{> tabelas/processos}}
       </main>
   </div>

   

