                    {{else}}
                    {{/each}}
                <table id="tabela" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>                            
                            <th scope="col">Autor</th>
                            <th scope="col">Réu</th>
                            <th scope="col">Entrada</th>
                            <th scope="col">Prioridade</th>
                            <th scope="col">Detalhes</th>
                        </tr>
                        
                    </thead>
                    <tbody>
                        {{#each cliente.Triagens}}
                        <tr>  
                            <td>{{Autor}}</td>
                            <td>{{Reu}}</td>
                            <td>{{#formatDate Entrada}}{{/formatDate}}</td>
                            <td>{{Prioridade}}</td>
                            <td onclick0="window.location='/cliente/detail/{{_id}}'"><i class="fa fa-search" style="color: #6e8efb; font-size: 20px; " ></i></td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
                    <div class="button-new" style="text-align: right">
                        <button type="submit" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#pedidoModal1"><i class="fas fa-plus"></i><a href="/processo/triagem"></a></button>
                    </div>
                </div>
            </div>

