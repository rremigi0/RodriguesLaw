<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>
<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li><i class="fas fa-home"></i><a href="/admin/home">  Home</a></li>
                <li><i class="fa fa-reply"></i><a href="/cliente/view">  Retornar</a></li>
                <li class="selected"><i class="fa fa-plus"></i><a href="/cliente/detail">  Detalhes</a></li>
            </ul>
           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i><a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>DADOS CADASTRAIS:</h2>
               </div>
               <div class="dynamic-content-edit">
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}

<!-- Menu de Navegação de Cadastro de Clientes -->
                 <form action="/cliente/edit" method="POST">
                      <input type="hidden" name="id" value="{{cliente._id}}">
                            <nav>
                            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                <a class="nav-item nav-link active" id="nav-geral-tab" data-toggle="tab" href="#nav-geral" role="tab" aria-controls="nav-geral" aria-selected="true">Geral</a>
                                <a class="nav-item nav-link" id="nav-documentos-tab" data-toggle="tab" href="#nav-documentos" role="tab" aria-controls="nav-documentos" aria-selected="false">Documentos</a>
                                <a class="nav-item nav-link" id="nav-endereco-tab" data-toggle="tab" href="#nav-endereco" role="tab" aria-controls="nav-endereco" aria-selected="false">Endereço</a>
                                <a class="nav-item nav-link" id="nav-contact-tab" data-toggle="tab" href="#nav-contact" role="tab" aria-controls="nav-contact" aria-selected="false">Contato</a>
                            </div>
                            </nav>

<!-- Aba Navegação Geral do Cadastro de Clientes -->

                        <div class="tab-content" id="nav-tabContent">
                            <div class="tab-pane fade show active" id="nav-geral" role="tabpanel" aria-labelledby="nav-geral-tab">
                                <div class="card-body">
                                  <div class="form-row">
                                      <div class="col-md-3 mb-3">
                                        <label for="codigo">Código*</label><input type="number" class="form-control" id="codigo" name="codigo" value="{{cliente.Codigo}}">
                                      </div>
                                      <div class="col-md-9 mb-9">
                                        <label for="nome">Nome</label><input type="text" class="form-control" id="nome" name="nome" value="{{cliente.Nome}}">
                                      </div>
                                  </div>
                                  <div class="form-row">
                                      <div class="col-md-3 mb-3">
                                          <label for="nascimento">Nascimento</label><input type="text" class="form-control" id="nascimento"  name="nascimento" value="{{cliente.Nascimento}}">
                                      </div>
                                      <div class="col-md-3 mb-3">
                                        <label for="sexo">Sexo</label><input type="text" class="form-control" id="sexo"  name="sexo" value="{{cliente.Sexo}}">
                                      </div>
                                      <div class="col-md-3 mb-3">
                                        <label for="estado">Estado Civil</label><input type="text" class="form-control" id="estado"  name="estado" value="{{cliente.Estado}}">
                                      </div>
                                      <div class="col-md-3 mb-3">
                                        <label for="nacionalidade">Nacionalidade</label><input type="text" class="form-control" id="nacionalidade" name="nacionalidade" value="{{cliente.Nacionalidade}}">
                                      </div>
                                  </div>
                              </div>
                          </div>

<!-- Aba Navegação Documentos do Cadastro de Clientes -->

                                <div class="tab-pane fade" id="nav-documentos" role="tabpanel" aria-labelledby="nav-documentos-tab">
                                    <div class="card-body">
                                        <div class="form row">
                                            <div class="col-md-6 mb-6">
                                                <label for="cpf_cnpj">CPF/CNPJ*</label><input type="text" class="form-control" id="cpf_cnpj" name="cpf_cnpj" value="{{cliente.Cpf_Cnpj}}">
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="identidade">Cédula de Identidade</label><input type="text" class="form-control" id="identidade" name="identidade" value="{{cliente.Identidade}}">
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="expedicao">Órgão de Expedição</label><input type="text" class="form-control" id="expedicao" name="expedicao" value="{{cliente.Expedicao}}">
                                            </div>
                                        </div>
                                        <div class="form row">
                                            <div class="col-md-6 mb-6">
                                                <label for="pis">PIS/PASEP</label><input type="text" class="form-control" id="pis" name="pis" value="{{cliente.PIS}}">
                                            </div>
                                            <div class="col-md-2 mb-2">
                                                <label for="uf_id">UF</label><input type="text" class="form-control" id="uf_id" name="uf_id" value="{{cliente.UF_ID}}">
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="emissao_id">Emissão</label><input type="text" class="form-control" id="emissao_id" name="emissao_id" value="{{cliente.Emissao_ID}}">
                                            </div>
                                        </div>
                                        <div class="form row">
                                            <div class="col-md-3 mb-3">
                                                <label for="ctps">Carteira de Trabalho</label><input type="text" class="form-control" id="ctps" name="ctps" value="{{cliente.CTPS}}">
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="serie_ctps">Série</label><input type="text" class="form-control" id="serie_ctps" name="serie_ctps" value="{{cliente.Serie_CTPS}}">
                                            </div>
                                            <div class="col-md-2 mb-2">
                                                <label for="uf_ctps">UF</label><input type="text" class="form-control" id="uf_ctps" name="uf_ctps" value="{{cliente.UF_CTPS}}">
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="emissao_ctps">Emissão</label><input type="text" class="form-control" id="emissao_ctps" name="emissao_ctps" value="{{cliente.Emissao_CTPS}}">
                                            </div>
                                        </div>
                                    </div>
                                </div>

<!-- Aba Navegação Endereço do Cadastro de Clientes -->

                                <div class="tab-pane fade" id="nav-endereco" role="tabpanel" aria-labelledby="nav-endereco-tab">
                                    <div class="card-body">
                                        <div class="form row">
                                            <div class="col-md-2 mb-2">
                                                <label for="tipo">Tipo</label><input type="text" class="form-control" id="tipo" name="tipo" value="{{cliente.Tipo}}">
                                            </div>
                                            <div class="col-md-6 mb-6">
                                                <label for="endereco">Endereço</label><input type="text" class="form-control" id="endereco" name="endereco" value="{{cliente.Endereco}}">
                                            </div>
                                            <div class="col-md-2 mb-2">
                                                <label for="numero">Número</label><input type="text" class="form-control" id="numero" name="numero" value="{{cliente.Numero}}">
                                            </div>
                                            <div class="col-md-2 mb-2">
                                                <label for="uf">UF</label><input type="text" class="form-control" id="uf" name="uf" value="{{cliente.UF}}">
                                            </div>
                                        </div>
                                        <div class="form row">
                                            <div class="col-md-4 mb-4">
                                                <label for="complemento">Complemento</label><input type="text" class="form-control" id="complemento" name="complemento" value="{{cliente.Complemento}}">
                                            </div>
                                            <div class="col-md-4 mb-4">
                                                <label for="bairro">Bairro</label><input type="text" class="form-control" id="bairro" name="bairro" value="{{cliente.Bairro}}">
                                            </div>
                                            <div class="col-md-4 mb-4">
                                                <label for="cidade">Cidade</label><input type="text" class="form-control" id="municipio" name="municipio" value="{{cliente.Municipio}}">
                                            </div>
                                        </div>
                                        <div class="form row">
                                            <div class="col-md-4 mb-4">
                                                <label for="cep">CEP</label><input type="text" class="form-control" id="cep" name="cep" value="{{cliente.CEP}}">
                                            </div>
                                        </div>
                                    </div>
                                </div>

<!-- Aba Navegação Endereço do Cadastro de Clientes -->

                                <div class="tab-pane fade" id="nav-contact" role="tabpanel" aria-labelledby="nav-contact-tab">
                                    <div class="card-body">
                                        <div class="form row">
                                            <div class="col-md-6 mb-6">
                                                <label for="celular">Celular</label><input type="text" class="form-control" id="celular" name="celular" value="{{cliente.Celular}}">
                                            </div>
                                            <div class="col-md-6 mb-6">
                                                <label for="email">Email</label><input type="email" class="form-control" id="email" name="email" value="{{cliente.Email}}"><br>
                                            </div>
                                            <div class="col-lg-12" style="text-align: right">
                                                <button type="submit" class="btn btn-success">Atualizar</button>
                                            </div>
                                        </div>  
                                    </div>
                                </div>  
                        </form>
                   </div>
            </div>
        </div>
        <div class="main-content-title">
            <br><h2>Histórico de Pedidos:</h2> 
        </div>
            <div class="dynamic-content-edit">
                <div class="card-body">
                    {{#each erros}}
                        <div class="alert alert-danger">{{texto}}</div>
                    {{else}}
                    {{/each}}
                <table id="tabela" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>                            
                            <th scope="col">Entrada</th>
                            <th scope="col">Tipo de Ação</th>
                            <th scope="col">Prioridade</th>
                            <th scope="col">Status</th>
                            <th scope="col">Detalhes</th>
                        </tr>        
                    </thead>
                    <tbody>
                        {{#each cliente.Triagens}}
                        <tr>  
                            <td>{{#formatDate Entrada}}{{/formatDate}}</td>
                            <td>{{Tipo}}</td>
                            <td>{{Prioridade}}</td>
                            <td>{{Status}}</td>
                            <td onclick0="window.location='/cliente/detail/{{_id}}'"><i class="fa fa-search" style="color: #6e8efb; font-size: 20px; " ></i></td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
                    <div class="button-new" style="text-align: right">
                        <button type="submit" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#pedidoModal"><i class="fas fa-plus"></i><a href="/processo/triagem"></a></button>
                    </div>
                </div>
            </div>

        <div class="main-content-title">
            <br><h2>Processos Associados</h2>
        </div>
            <div class="dynamic-content-edit">
                <div class="card-body">
                    {{#each erros}}
                        <div class="alert alert-danger">{{texto}}</div>
                    {{else}}
                    {{/each}}
                </div>
            </div>

<!-- Cadastro de Novo Pedido (Modal Novo Pedido) -->

    <div class="modal fade" id="pedidoModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="dynamic-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cadastrar Novo Ticket</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>      
                    </div>        
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}

<!-- Aba Navegação Geral do Novo Ticket -->

                        <form action="/processo/add/addTriagem" method="POST">
                            <div class="tab-content" id="nav-tabContent">
                                <div class="tab-pane fade show active" id="nav-geral" role="tabpanel" aria-labelledby="nav-geral-tab">
                                    <div class="card-body">
                                        <div class="form-row">
                                            <div class="col-md-6 mb-6">
                                                <label for="cliente">Cliente</label>
                                                    <select name="cliente" class="custom-select">
                                                        {{#each cliente}}
                                                            <option value="{{_id}}">{{Nome}}</option>
                                                        {{else}}
                                                            <option value="">Nenhum Cliente Registrado</option>
                                                        {{/each}}
                                                    </select>
                                            </div>
                                            <div class="col-md-6 mb-6">
                                                <label for="autor">Autor</label><input type="text" class="form-control" id="autor" name="autor" placeholder="Digite o Nome Completo">
                                            </div>
                                        </div>
                                        <div class="form-row">
                                            <div class="col-md-6 mb-6">
                                                <label for="reu">Réu</label><input type="text" class="form-control" id="reu" name="reu" placeholder="Digite o Nome Completo">
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="tutela">Tutela</label>
                                                    <select class="form-control" id="tutela" name="tutela">
                                                        <option>Sim</option>
                                                        <option>Não</option>
                                                    </select>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="entrada">Data de Entrada</label><input type="date" class="form-control" id="entrada" name="entrada">
                                            </div>
                                        </div>    
                                        <div class="form-row">
                                            <div class="col-md-3 mb-3">
                                                <label for="prioridade">Prioridade</label>
                                                    <select class="form-control" id="prioridade" name="prioridade">
                                                        <option>Verde</option>
                                                        <option>Amarelo</option>
                                                        <option>Vermelho</option>
                                                    </select>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="status">Status</label>
                                                    <select class="form-control" id="status" name="status">
                                                        <option>Pendente</option>
                                                        <option>Em Andamento</option>
                                                        <option>Concluído</option>
                                                    </select>
                                            </div>
                                            <div class="col-md-6 mb-6">
                                                <label for="tipo">Tipo de Ação</label><input type="text" class="form-control" id="tipo" name="tipo" placeholder="Ex.: Reclamação Trabalhista">
                                            </div>
                                        </div>
                                    <button type="submit" class="btn">Cadastrar</button>                                                               
                                </div>
                            </div>
                        </div>   
                    </form>
    
       </main>

   </div>
    <script src="/js/menu.js"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script type="text/javascript" src="/js/filter.js"></script>   
</body>
</html>

