   <div class="flex-dashboard">
       {{> menu/clientes/main}}
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Gerenciar Clientes</h2>
               </div>
               <div class="dynamic-content">
                        <table id="tabela" class="table table-striped table-bordered" style="width:100%">             
                            <thead>

                                <tr>
                                <div class="button-new" style="text-align: right">
                                    <button type="submit" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#add"><i class="fas fa-plus"></i><a href="/processo/triagem"></a></button>
                                </div>
                                    <th class="table-search1" scope="col">Pesquisar:</th>
                                    <th class="table-search"><input type="text" class="form-control form-control-sm" id="txtColuna2"  style="width:100%" placeholder="Digite o Nome do Cliente" ></th>
                                    <th class="table-search"><input type="text" class="form-control form-control-sm" id="txtColuna3"  style="width:100%" placeholder="Digite o CPF/CNPJ" ></th>
                                    <th class="table-search" scope="col"></th>
                                    <th class="table-search" scope="col"></th>
                                </tr>
                                <tr>
                                    <th scope="col">Código</th>
                                    <th scope="col">Nome</th>
                                    <th scope="col">CPF/CNPJ</th>
                                    <th scope="col">Detalhes</th>
                                    <th scope="col">Excluir</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each clientes}}
                                <tr >  
                                    <td>{{Codigo}}</td>
                                    <td>{{Nome}}</td>
                                    <td>{{Cpf_Cnpj}}</td>
                                    <td onclick="window.location='/cliente/detail/{{_id}}'"><i class="fa fa-search" style="color: #6e8efb; font-size: 20px; " ></i></td>
                                    <td onclick="window.location='/cliente/deletar/{{_id}}'"><i class="fas fa-trash-alt" style="color: #6e8efb; font-size: 18px; "></i></td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                </div>
            </div>
       </main>
{{> modal/cliente/add}}
    </div>



