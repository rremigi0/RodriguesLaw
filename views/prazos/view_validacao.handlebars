<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>
<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li>
                    <i class="fas fa-home"></i>
                    <a href="/admin/dashboard">  Dashboard</a>
            
                </li>
                <li>
                    <i class="fas fa-user-tie"></i>
                    <a href="/admin/perfil">  Perfil</a>
                </li>
                <li>
                    <i class="fas fa-plus"></i>
                    <a href="/admin/cadastro">  Cadastro</a>
                </li>
                <li>
                    <i class="fas fa-users"></i>
                    <a href="/cliente/main">  Clientes</a>
                </li>
                <li>
                    <i class="fas fa-layer-group"></i>
                    <a href="/processo/main">  Processos</a>
                </li>
                <li>
                    <i class="far fa-calendar-alt"></i>
                    <a href="/audiencia/main">  Audiências</a>
                </li>
                <li class="selected">
                    <i class="far fa-newspaper"></i>
                    <a href="/prazo/main">  Prazos</a>
                </li>
                <li>
                    <i class="fas fa-money-check-alt"></i>
                    <a href="/financeiro/main">  Financeiro</a>
                </li>
                <li>
                    <i class="fas fa-cog"></i>
                    <a href="/admin/Configuracoes">  Configurações</a>
                </li>
                <li class="sidebar_logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <a href="/usuarios/logout">  Logout</a>
                </li>
            </ul>

           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
               <a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Gerenciar Prazos</h2>
               </div>
               <div class="panel-row">
                   
                    <nav class ="nav_tabs">
                        <ul>
                            <li>
                                <input type="radio" name="tabs" class="rd_tabs" id="pendentes" >
                                <label onclick="window.location='/prazo/view_pendentes/'" for ="pendentes">Prazos Pendentes</label>

                            </li>

                            <li>
                                <input type="radio" name="tabs" class="rd_tabs" id="validacao" checked>
                                <label onclick="window.location='/prazo/view_validacao/'" for ="controle">Aguardando Validação</label>
                            </li>

                            <li>
                                <input type="radio" name="tabs" class="rd_tabs" id="erros">
                                <label onclick="window.location='/prazo/view_erros/'" for ="erros">Retornado com Erros</label>
                            </li>

                            <li>
                                <input type="radio" name="tabs" class="rd_tabs" id="protocolado">
                                <label onclick="window.location='/prazo/view_protocolado/'" for ="protocolados">Prazos Protocolados</label>
                            </li>
                        </ul>
                    </nav>

               </div>
               <div class="dynamic-content">

                   <table class="table table-striped">                  
                            <thead>
                            <tr>
                                <th scope="col">Processo</th>
                                <th scope="col">Autor</th>
                                <th scope="col">Réu</th>
                                <th scope="col">Petição</th>
                                <th scope="col">Prazo</th>
                                <th scope="col">Editar</th>
                                <th scope="col">Concluir</th>
                                <th scope="col">Excluir</th>
                            </tr>
                        </thead>
                    <tbody>
                       {{#each prazos}}

                            <tr>    
                                <td>{{Processo}}</td>
                                <td>{{Autor}}</td>
                                <td>{{Reu}}</td>
                                <td>{{Peticao}}</td>
                                <td>{{#formatDate Prazo}}{{/formatDate}}</td>
                                <td onclick="window.location='/prazo/edit/{{_id}}'"><i class="fas fa-edit"></i></td>
                                <td onclick="window.location='/prazo/atualizar/{{_id}}'"><i class="fas fa-sync-alt"></i></td>
                                <td onclick="window.location='/prazo/deletar/{{_id}}'"><i class="fas fa-trash-alt"></i></td>
                            </tr>
                        {{/each}}
                    </tbody>
                        
                    </table>
                    </form>
                </div>
       </main>
   </div>
                

    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/ajax.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>



