<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>
<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li>
                    <i class="fa fa-reply"></i>
                    <a href="/admin/home">  Retornar</a>
            
                </li>
                <li>
                    <i class="fas fa-plus"></i>
                    <a href="/prazo/add" data-toggle="modal" data-target="#prazosModal">  Novo</a>
                </li>
                <li>
                    <i class="fa fa-search"></i>
                    <a href="/prazo/view_pendentes">  Consultar</a>
                </li>
            </ul>

           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
               <a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Gerenciar Prazos</h2>
               </div>
           </div>
       </main>

<!-- Cadastro de Prazos (Modal Novo Prazo) -->

    <div class="modal fade" id="prazosModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="dynamic-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cadastrar Novo Prazo</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>      
                    </div>        
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}
                <form action="/prazo/add/addPrazos" method="POST">
                    <div class="form-group">
                        <label for="processo">Processo</label><input type="text" class="form-control" id="processo" name="processo">

                        <label for="autor">Autor</label><input type="text" class="form-control" id="autor" name="autor">

                        <label for="reu">Réu</label><input type="text" class="form-control" id="reu" name="reu">

                        <label for="procedimento">Procedimento</label><input type="text" class="form-control" id="procedimento" name="procedimento">

                        <label for="peticao">Petição Processual</label><input type="text" class="form-control" id="peticao" name="peticao">
                    
                        <label for="publicacao">Publicação</label><input type="date" class="form-control" id="publicacao" name="publicacao">

                        <label for="prazo">Prazo</label><input type="date" class="form-control" id="prazo" name="prazo">
                        <label for="status">Status</label>
                        <select class="form-control" id="status" name="status">
                            <option>Pendente</option>
                        </select>

                    </div>
                    <button type="submit" class="btn">Cadastrar</button>
                  </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
   </div>
   </div>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/ajax.js"></script>
    <script src="/js/menu.js"></script>
  
    </script>


</body>
</html>