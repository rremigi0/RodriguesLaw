<!-- Menu Dropdown de Cadastro de Clientes (Modal Novo Cliente) -->

    <div class="modal fade" id="clienteModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="dynamic-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cadastrar Cliente</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>      
                    </div>        
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}
                        <form action="/cliente/add/addClientes" method="POST">
                            <div class="form-group">
                            <label for="codigo">Código</label>
                            <input type="number" class="form-control" id="codigo" aria-describedby="emailHelp" name="codigo">
                            <label for="nome">Nome</label>
                            <input type="text" class="form-control" id="nome" aria-describedby="emailHelp" name="nome">
                            <label for="cpf_cnpj">CPF/CNPJ</label>
                            <input type="text" class="form-control" id="cpf_cnpj" aria-describedby="emailHelp" name="cpf_cnpj">
                            <label for="nascimento">Nascimento</label>
                            <input type="text" class="form-control" id="nascimento" aria-describedby="emailHelp" name="nascimento">
                            <label for="sexo">Sexo</label>
                            <input type="text" class="form-control" id="sexo" aria-describedby="emailHelp" name="sexo">
                            <label for="celular">Celular</label>
                            <input type="text" class="form-control" id="celular" aria-describedby="emailHelp" name="celular"><br>
                            <button type="submit" class="btn">Salvar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- Menu Dropdown de Cadastro de Processos (Modal Novo Processo) -->

    <div class="modal fade" id="processoModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="dynamic-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cadastrar Processo</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>      
                    </div>        
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}
                        <form action="/processo/add/addProcessos" method="POST">
                            <div class="form-group">
                                <label for="cliente">Cliente</label>
                                        <select name="cliente" class="custom-select">
                                            {{#each clientes}}
                                                <option value="{{_id}}">{{Nome}}</option>
                                            {{else}}
                                                <option value="">Nenhum Cliente Registrado</option>
                                            {{/each}}
                                        </select>
                                <label for="processo">Processo</label><input type="text" class="form-control" id="processo" aria-describedby="emailHelp" name="processo">
                                <label for="procedimento">Procedimento</label><input type="text" class="form-control" id="procedimento" aria-describedby="emailHelp" name="procedimento">
                                <label for="categoria">Categoria</label><input type="text" class="form-control" id="categoria" aria-describedby="emailHelp" name="categoria">
                                <label for="tutela">Tutela</label><input type="text" class="form-control" id="tutela" aria-describedby="emailHelp" name="tutela">
                                <label for="classe">Classe</label><input type="text" class="form-control" id="classe" aria-describedby="emailHelp" name="classe">
                                <label for="assunto">Assunto</label><input type="text" class="form-control" id="assunto" aria-describedby="emailHelp" name="assunto">
                                <label for="autor">Autor</label><input type="text" class="form-control" id="autor" name="autor">
                                <label for="reu">Réu</label><input type="text" class="form-control" id="reu" name="reu">
                                <label for="secao">Seção</label><input type="text" class="form-control" id="secao" name="secao">
                                <label for="vara">Vara</label><input type="text" class="form-control" id="vara" name="vara">
                                <label for="comarca">Comarca</label><input type="text" class="form-control" id="comarca" aria-describedby="emailHelp" name="comarca">
                                <label for="uf">UF</label><input type="text" class="form-control" id="uf" aria-describedby="emailHelp" name="uf">
                                <label for="audiencia">Audiencia</label><input type="datetime-local" class="form-control" id="audiencia" name="audiencia">
                                <label for="atuacao">Atuacao</label><input type="date" class="form-control" id="atuacao" name="atuacao">
                                <label for="distribuicao">Distribuição</label><input type="date" class="form-control" id="distribuicao" name="distribuicao">
                                <label for="status">Status</label>
                                    <select class="form-control" id="status" name="status">
                                        <option>Ativo</option>
                                        <option>Arquivado</option>
                                    </select><br>
                            <button type="submit" class="btn">Salvar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>


