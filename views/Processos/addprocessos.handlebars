<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>
<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li>
                    <i class="fas fa-home"></i>
                    <a href="/admin/dashboard">  Dashboard</a>
            
                </li>
                <li>
                    <i class="fas fa-user-tie"></i>
                    <a href="/admin/perfil">  Perfil</a>
                </li>
                <li>
                    <i class="fas fa-users"></i>
                    <a href="/cliente/main">  Clientes</a>
                </li>
                <li class="selected">
                    <i class="fas fa-layer-group"></i>
                    <a href="/processo/main">  Processos</a>
                </li>
                <li>
                    <i class="far fa-calendar-alt"></i>
                    <a href="/audiencia/main">  Audiências</a>
                </li>
                <li>
                    <i class="far fa-newspaper"></i>
                    <a href="/prazo/main">  Prazos</a>
                </li>
                <li>
                    <i class="fas fa-money-check-alt"></i>
                    <a href="/financeiro/main">  Financeiro</a>
                </li>
                <li>
                    <i class="fas fa-cog"></i>
                    <a href="/admin/Configuracoes">  Configurações</a>
                </li>
                <li class="sidebar_logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <a href="/usuarios/logout">  Logout</a>
                </li>
            </ul>

           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
               <a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Gerenciar Processos</h2>
               </div>
               <div class="panel-row">
                   
                   <a href="/processo/add"><button class="panel panel-50" a-view="cadastrarProcessos" onclick="fetchContent(this)" a-folder="Processos">
                    <i class="fas fa-plus"></i>
                    Cadastrar Processos
                    </button></a>
                   <a href="/processo/view"><button class="panel panel-50" a-view="visualizarProcessos" onclick="fetchContent(this)" a-folder="processos">
                    <i class="fas fa-table"></i>
                    Consultar Processos
                    </button></a>
               </div>
               <div class="dynamic-content">
                   <div class="card-body"></div>
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}
                  <form action="/processo/add/addProcessos" method="POST">
                    <div class="form-group">
                      <label for="processo">Processo</label>
                      <input type="text" class="form-control" id="processo" aria-describedby="emailHelp" name="processo">
                    </div>
                    <div class="form-group">
                      <label for="procedimento">Procedimento</label>
                      <input type="text" class="form-control" id="procedimento" aria-describedby="emailHelp" name="procedimento">
                    </div>
                    <div class="form-group">
                      <label for="categoria">Categoria</label>
                      <input type="text" class="form-control" id="categoria" aria-describedby="emailHelp" name="categoria">
                    </div>
                    <div class="form-group">
                      <label for="tutela">Tutela</label>
                      <input type="text" class="form-control" id="tutela" aria-describedby="emailHelp" name="tutela">
                    </div>
                    <div class="form-group">
                      <label for="classe">Classe</label>
                      <input type="text" class="form-control" id="classe" aria-describedby="emailHelp" name="classe">
                    </div>
                    <div class="form-group">
                      <label for="assunto">Assunto</label>
                      <input type="text" class="form-control" id="assunto" aria-describedby="emailHelp" name="assunto">
                    </div>
                    <div class="form-group">
                        <label for="autor">Autor</label>
                        <input type="text" class="form-control" id="autor" name="autor">
                    </div>
                    <div class="form-group">
                        <label for="reu">Réu</label>
                        <input type="text" class="form-control" id="reu" name="reu">
                    </div>
                    <div class="form-group">
                        <label for="secao">Seção</label>
                        <input type="text" class="form-control" id="secao" name="secao">
                    </div>
                    <div class="form-group">
                        <label for="vara">Vara</label>
                        <input type="text" class="form-control" id="vara" name="vara">
                    </div>
                    <div class="form-group">
                      <label for="comarca">Comarca</label>
                      <input type="text" class="form-control" id="comarca" aria-describedby="emailHelp" name="comarca">
                    </div>
                    <div class="form-group">
                      <label for="uf">UF</label>
                      <input type="text" class="form-control" id="uf" aria-describedby="emailHelp" name="uf">
                    </div>
                    <div class="form-group">
                        <label for="audiencia">Audiencia</label>
                        <input type="datetime-local" class="form-control" id="audiencia" name="audiencia">
                    </div>
                    <div class="form-group">
                        <label for="atuacao">Atuacao</label>
                        <input type="date" class="form-control" id="atuacao" name="atuacao">
                    </div>

                    <div class="form-group">
                        <label for="distribuicao">Distribuição</label>
                        <input type="date" class="form-control" id="distribuicao" name="distribuicao">
                    </div>

                    <div class="form-group">
                      <label for="cliente">Cliente</label>
                      <select name="cliente" class="custom-select">
                          {{#each clientes}}
                            <option value="{{_id}}">{{Nome}}</option>
                          {{else}}
                            <option value="">Nenhum Cliente Registrado</option>
                          {{/each}}
                      </select>
                    </div>
                    <button type="submit" class="btn">Cadastrar</button>
                  </form>
            </div>
       </main>
   </div>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/ajax.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>

