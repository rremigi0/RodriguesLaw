<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>
<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li>
                    <i class="fas fa-home"></i>
                    <a href="/admin/dashboard">  Dashboard</a>
            
                </li>
                <li>
                    <i class="fas fa-user-tie"></i>
                    <a href="/admin/perfil">  Perfil</a>
                </li>
                <li>
                    <i class="fas fa-users"></i>
                    <a href="/admin/clientes">  Clientes</a>
                </li>
                <li>
                    <i class="fas fa-layer-group"></i>
                    <a href="/processo/main">  Processos</a>
                </li>
                <li>
                    <i class="far fa-calendar-alt"></i>
                    <a href="/admin/audiencias">  Audiências</a>
                </li>
                <li class="selected">
                    <i class="far fa-newspaper"></i>
                    <a href="/prazo/main">  Prazos</a>
                </li>
                <li>
                    <i class="fas fa-money-check-alt"></i>
                    <a href="/financeiro/main">  Financeiro</a>
                </li>
                <li>
                    <i class="fas fa-cog"></i>
                    <a href="/admin/csonfiguracoes">  Configurações</a>
                </li>
                <li class="sidebar_logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <a href="/usuarios/logout">  Logout</a>
                </li>
            </ul>

           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
               <a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Gerenciar Honorários</h2>
               </div>
               <div class="panel-row">
                   
                   <a href="/financeiro/add"><button class="panel panel-50" a-view="cadastrarHonorarios" onclick="fetchContent(this)" a-folder="honorarios">
                    <i class="fas fa-plus"></i>
                    Cadastrar Honorários
                    </button></a>
                   <a href="/financeiro/view"><button class="panel panel-50" a-view="visualizarHonorarios" onclick="fetchContent(this)" a-folder="honorários">
                    <i class="fas fa-table"></i>
                    Consultar Honorários
                    </button></a>
               </div>
               <div class="dynamic-content">
                   <div class="card-body"></div>
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}
                  <form action="/financeiro/add/addFinanceiro" method="POST">
                    <div class="form-group">
                      <label for="processo">Processo</label>
                      <input type="text" class="form-control" id="processo" aria-describedby="emailHelp" name="processo">
                    </div>
                    <div class="form-group">
                        <label for="autor">Autor</label>
                        <input type="text" class="form-control" id="autor" name="autor">
                    </div>
                    <div class="form-group">
                        <label for="reu">Réu</label>
                        <input type="text" class="form-control" id="reu" name="reu">
                    </div>
                    <div class="form-group">
                        <label for="competencia">Competencia</label>
                        <input type="text" class="form-control" id="competencia" name="competencia">
                    </div>
                    <div class="form-group">
                        <label for="tipo">Tipo</label>
                        <input type="text" class="form-control" id="tipo" name="tipo">
                    </div>
                    <div class="form-group">
                        <label for="vencimento">Vencimento</label>
                        <input type="date" class="form-control" id="vencimento" name="vencimento">
                    </div>
                    <div class="form-group">
                        <label for="honorarios">Honorario</label>
                        <input type="text" class="form-control" id="honorarios" name="honorarios">
                    </div>
                    <div class="form-group">
                        <label for="status">Status</label>
                        <input type="text" class="form-control" id="status" name="status">
                    </div>
                    <button type="submit" class="btn">Cadastrar</button>
                  </form>
            </div>
       </main>
   </div>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/ajax.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>

