<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/all.css">
    <link rel="stylesheet" href="/plugins/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/plugins/fontawesome/css/all.min.css">
    <title>Sistema Jurídico</title>
</head>
<body>
   <div class="flex-dashboard">
       <sidebar id="sidebar">
           <div class="sidebar-title">
            <img src="/Images/Cor Azul.png" alt="">
            <h2>Rodrigues Advocacia</h2>
           </div>
           <div class="menu">
            <ul>
                <li>
                    <i class="fas fa-home"></i>
                    <a href="/admin/dashboard">  Dashboard</a>
            
                </li>
                <li>
                    <i class="fas fa-user-tie"></i>
                    <a href="/admin/perfil">  Perfil</a>
                </li>
                <li class="selected">
                    <i class="fas fa-plus"></i>
                    <a href="/admin/cadastro">  Cadastro</a>
                </li>
                <li>
                    <i class="fas fa-layer-group"></i>
                    <a href="/processo/main">  Processos</a>
                </li>
                <li>
                    <i class="far fa-calendar-alt"></i>
                    <a href="/audiencia/main">  Audiências</a>
                </li>
                <li>
                    <i class="far fa-newspaper"></i>
                    <a href="/prazo/main">  Prazos</a>
                </li>
                <li>
                    <i class="fas fa-money-check-alt"></i>
                    <a href="/financeiro/main">  Financeiro</a>
                </li>
                <li>
                    <i class="fas fa-cog"></i>
                    <a href="/admin/Configuracoes">  Configurações</a>
                </li>
                <li class="sidebar_logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <a href="/usuarios/logout">  Logout</a>
                </li>
            </ul>

           </div>
       </sidebar>
       <main id="mainContent">
           <header>
                <i id="iconMenu" onclick="responsiveSidebar()" class="fas fa-bars"></i>
               <a href="/usuarios/logout"> <i class="fas fa-sign-out-alt"></i> Logout</a>
           </header>
           <div class="main-content">
               <div class="main-content-title">
                   <h2>Gerenciar Clientes</h2>
               </div>
               <div class="panel-row">
                   
                   <a href="/clientes/add"><button class="panel panel-50" a-view="cadastrarClientes" onclick="fetchContent(this)" a-folder="Clientes">
                    <i class="fas fa-plus"></i>
                    Cadastrar Clientes
                    </button></a>
                   <a href="/clientes/view"><button class="panel panel-50" a-view="visualizarClientes" onclick="fetchContent(this)" a-folder="Clientes">
                    <i class="fas fa-table"></i>
                    Consultar Clientes
                    </button></a>
               </div>
               <div class="dynamic-content">
                   <div class="card-body"></div>
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}
                  <form action="/cliente/edit" method="POST">
                      <input type="hidden" name="id" value="{{cliente._id}}">
                    <div class="form-group">
                      <label for="codigo">Código</label>
                      <input type="number" class="form-control" id="codigo" aria-describedby="emailHelp" name="codigo" value="{{cliente.Codigo}}">
                    </div>
                    <div class="form-group">
                      <label for="nome">Nome</label>
                      <input type="text" class="form-control" id="nome" aria-describedby="emailHelp" name="nome" value="{{cliente.Nome}}">
                    </div>
                    <div class="form-group">
                      <label for="cpf_cnpj">CPF/CNPJ</label>
                      <input type="text" class="form-control" id="cpf_cnpj" aria-describedby="emailHelp" name="cpf_cnpj" value="{{cliente.Cpf_Cnpj}}">
                    </div>
                    <div class="form-group">
                      <label for="nascimento">Nascimento</label>
                      <input type="text" class="form-control" id="nascimento" aria-describedby="emailHelp" name="nascimento" value="{{cliente.Nascimento}}">
                    </div>
                    <div class="form-group">
                      <label for="sexo">Sexo</label>
                      <input type="text" class="form-control" id="sexo" aria-describedby="emailHelp" name="sexo" value="{{cliente.Sexo}}">
                    </div>
                    <div class="form-group">
                      <label for="celular">Celular</label>
                      <input type="text" class="form-control" id="celular" aria-describedby="emailHelp" name="celular" value="{{cliente.Celular}}">
                    </div>
                    <button type="submit" class="btn">Salvar</button>
                     
                  </form>
            </div>
       </main>
   </div>
    <script src="/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/plugins/fontawesome/js/all.min.js"></script>
    <script src="/js/ajax.js"></script>
    <script src="/js/menu.js"></script>
</body>
</html>

