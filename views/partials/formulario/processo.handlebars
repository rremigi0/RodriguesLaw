                                            <label for="vara">Vara</label><input type="text" class="form-control" id="vara" name="vara" value="{{processo.Vara}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="comarca">Comarca</label><input type="text" class="form-control" id="comarca" name="comarca" value="{{processo.Comarca}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="uf">UF</label><input type="text" class="form-control" id="uf" name="uf" value="{{processo.UF}}">
                                        </div>
                                    </div>
                                </div>
                            </div>

<!-- Aba Navegação Movimentação -->

                            <div class="tab-pane fade" id="nav-movimentacoes" role="tabpanel" aria-labelledby="nav-movimentacoes">
                                <div class="card-body">
                                    <div class="form row">
                                        <div class="col-md-3 mb-3">
                                            <label for="UltimaMov">Última Movimentação</label><input type="date" class="form-control" id="UltimaMov" name="UltimaMov" value="{{#formatDateUS processo.UltimaMov}}{{/formatDateUS}}">
                                        </div>
                                        <div class="col-md-9 mb-9">
                                            <label for="movimento">Movimento</label><input type="text" class="form-control" id="movimento" name="movimento" value="{{processo.Movimento}}">
                                        </div>
                                    </div>
                                </div>
                            </div>

<!-- Aba Navegação Status -->

                            <div class="tab-pane fade" id="nav-status" role="tabpanel" aria-labelledby="nav-status">
                                <div class="card-body">
                                    <div class="form row">
                                        <div class="col-md-3 mb-3">
                                            <label for="atuacao">Atuação</label><input type="date" class="form-control" id="atuacao" name="atuacao" value="{{#formatDateUS processo.Atuacao}}{{/formatDateUS}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="distribuicao">Distribuicao</label><input type="date" class="form-control" id="distribuicao" name="distribuicao" value="{{#formatDateUS processo.Distribuicao}}{{/formatDateUS}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="status">Status</label><input type="text" class="form-control" id="status" name="status" value="{{processo.Status}}">
                                        </div>
                                        <div class="col-lg-12" style="text-align: right">
                                            <button type="submit" class="btn btn-success">Atualizar</button>
                                        </div>                        
                                    </div>
                                </div>                     
                            </div>
                        </form>                        
                    </div>
                </div>
            </div>