                                <div class="card-body">
                                    <div class="form-row">
                                      <div class="col-md-4 mb-4">
                                        <label for="processo">Número</label><input type="text" class="form-control" id="processo" aria-describedby="emailHelp" name="processo" value="{{processo.Processo}}">
                                      </div>
                                      <div class="col-md-6 mb-6">
                                        <label for="autor">Autor</label><input type="text" class="form-control" id="autor" name="autor" value="{{processo.Autor}}">
                                      </div>
                                      <div class="col-md-6 mb-6">
                                        <label for="reu">Réu</label><input type="text" class="form-control" id="reu" name="reu" value="{{processo.Reu}}">
                                      </div>                                        
                                    </div>
                                </div>
                            </div>

<!-- Aba Navegação Dados -->

                            <div class="tab-pane fade" id="nav-dados" role="tabpanel" aria-labelledby="nav-dados">
                                <div class="card-body">
                                    <div class="form row">
                                        <div class="col-md-9 mb-9">
                                            <label for="procedimento">Procedimento</label><input type="text" class="form-control" id="procedimento" aria-describedby="emailHelp" name="procedimento" value="{{processo.Procedimento}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="tutela">Tutela?</label><input type="text" class="form-control" id="tutela" aria-describedby="emailHelp" name="tutela" value="{{processo.Tutela}}">
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <label for="categoria">Categoria</label><input type="text" class="form-control" id="categoria" aria-describedby="emailHelp" name="categoria" value="{{processo.Categoria}}">
                                        </div>
                                        <div class="col-md-4 mb-4">
                                            <label for="classe">Classe</label><input type="text" class="form-control" id="classe" aria-describedby="emailHelp" name="classe" value="{{processo.Classe}}">
                                        </div>
                                        <div class="col-md-4 mb-4">
                                            <label for="assunto">Assunto</label><input type="text" class="form-control" id="assunto" aria-describedby="emailHelp" name="assunto" value="{{processo.Assunto}}">
                                        </div>
                                    </div>
                                </div>
                            </div>

<!-- Aba Navegação Audiência -->

                            <div class="tab-pane fade" id="nav-audiencia" role="tabpanel" aria-labelledby="nav-audiencia">
                                <div class="card-body">
                                    <div class="form row">
                                        <div class="col-md-4 mb-4">
                                            <label for="audiencia">Audiencia</label><input type="datetime-local" class="form-control" id="audiencia" name="audiencia" value="{{#formatDateTime processo.Audiencia}}{{/formatDateTime}}">
                                        </div>
                                    </div>
                                </div>
                            </div>

<!-- Aba Navegação Órgão Julgador -->

