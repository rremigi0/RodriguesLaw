                                <a class="nav-item nav-link" id="nav-audiencia-tab" data-toggle="tab" href="#nav-audiencia" role="tab" aria-controls="nav-audiencia" aria-selected="false">Audiência</a>
                                <a class="nav-item nav-link" id="nav-julgador-tab" data-toggle="tab" href="#nav-julgador" role="tab" aria-controls="nav-julgador" aria-selected="false">Órgão Julgador</a>
                                <a class="nav-item nav-link" id="nav-movimentacoes-tab" data-toggle="tab" href="#nav-movimentacoes" role="tab" aria-controls="nav-movimentacoes" aria-selected="false">Movimentações</a>
                                <a class="nav-item nav-link" id="nav-status-tab" data-toggle="tab" href="#nav-status" role="tab" aria-controls="nav-status" aria-selected="false">Status</a>
                            </div>
                            </nav>

<!-- Aba Navegação Geral do Detalhe do Processo -->

