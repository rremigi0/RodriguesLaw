<!-- Aba Navegação Prazos -->
<nav>
    <div class="nav nav-tabs" id="nav-tab" role="tablist">
        <a class="nav-item nav-link active" id="nav-prazos-tab" data-toggle="tab" href="#nav-prazos" role="tab" aria-controls="nav-prazos" aria-selected="true">Prazos</a>
        <a class="nav-item nav-link" id="nav-diligencias-tab" data-toggle="tab" href="#nav-diligencias" role="tab" aria-controls="nav-diligencias" aria-selected="false">Diligências</a>
        <a class="nav-item nav-link" id="nav-push-tab" data-toggle="tab" href="#nav-push" role="tab" aria-controls="nav-push" aria-selected="false">Push</a>
    </div>
</nav>
        <div class="tab-content" id="nav-tabContent">
            <div class="tab-pane fade show active" id="nav-prazos" role="tabpanel" aria-labelledby="nav-prazos">
                <div class="card-body">
                    {{#each erros}}
                    <div class="alert alert-danger">{{texto}}</div>
                    {{else}}
                    {{/each}}
                        <table id="tabela" class="table table-striped table-bordered" style="width:100%; margin-top: 5px">
                            <thead>
                                <tr>                            
                                    <th scope="col">Autor</th>
                                    <th scope="col">Reu</th>
                                    <th scope="col">Peticao</th>
                                    <th scope="col">Publicacao</th>
                                    <th scope="col">Prazo</th>
                                    <th scope="col">Atualizar</th>
                                </tr>        
                            </thead>
                            <tbody>
                            {{#each processo.Prazos}}
                                <tr>  
                                    <td>{{Autor}}</td>
                                    <td>{{Reu}}</td>
                                    <td>{{Peticao}}</td>
                                    <td>{{#formatDate Publicacao}}{{/formatDate}}</td>
                                    <td>{{#formatDate Prazo}}{{/formatDate}}</td>
                                    <td onclick="window.location='/prazo/atualizar/{{_id}}'"><i class="fas fa-sync-alt" style="color: #6e8efb; font-size: 20px;"></i></td>
                                </tr>
                            {{/each}}
                            </tbody>
                        </table>
                        <div class="button-new" style="text-align: right">
                            <button type="submit" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#prazoModal"><i class="fas fa-plus"></i></button>
                        </div>
                </div>
            </div>