        <div class="main-content-title">
            <br><h2>Histórico de Pedidos:</h2> 
        </div>
            <div class="dynamic-content-edit">
                <div class="card-body">
                    {{#each erros}}
                        <div class="alert alert-danger">{{texto}}</div>
                    {{else}}
                    {{/each}}
                <table id="tabela" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>                            
                            <th scope="col">Entrada</th>
                            <th scope="col">Tipo de Ação</th>
                            <th scope="col">Prioridade</th>
                            <th scope="col">Status</th>
                            <th scope="col">Detalhes</th>
                            <th scope="col">Excluir</th>
                        </tr>        
                    </thead>
                    <tbody>
                        {{#each cliente.Triagens}}
                        <tr>  
                            <td>{{#formatDate Entrada}}{{/formatDate}}</td>
                            <td>{{Tipo}}</td>
                            <td>{{Prioridade}}</td>
                            <td>{{Status}}</td>
                            <td data-toggle0="modal" data-target="#pedidoModal"><i class="fa fa-search" style="color: grey; font-size: 20px; " ></i></td>
                            <td onclick="window.location='/processo/deletartriagem/{{_id}}'"><i class="fas fa-trash-alt" style="color: #6e8efb; font-size: 18px; "></i></td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
                    <div class="button-new" style="text-align: right">
                        <button type="submit" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#pedidoModal"><i class="fas fa-plus"></i><a href="#"></a></button>
                    </div>
                </div>
            </div>