<!-- Aba Navegação Diligencias -->

            <div class="tab-pane fade" id="nav-diligencias" role="tabpanel" aria-labelledby="nav-diligencias">
                <div class="card-body">
                    {{#each erros}}
                    <div class="alert alert-danger">{{texto}}</div>
                    {{else}}
                    {{/each}}
                        <table id="tabela" class="table table-striped table-bordered" style="width:100%; margin-top: 5px">
                            <thead>
                                <tr>                            
                                    <th scope="col">Autor</th>
                                    <th scope="col">Reu</th>
                                    <th scope="col">Peticao</th>
                                    <th scope="col">Prazo</th>
                                </tr>        
                            </thead>
                            <tbody>
                            {{#each processo.Diligencias}}
                                <tr>  
                                    <td>{{Autor}}</td>
                                    <td>{{Reu}}</td>
                                    <td>{{Peticao}}</td>
                                    <td>{{#formatDate Prazo}}{{/formatDate}}</td>
                                </tr>
                            {{/each}}
                            </tbody>
                        </table>
                        <div class="button-new" style="text-align: right">
                            <button type="submit" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#diligenciaModal" style="background-color: red;"><i class="fas fa-plus"></i></button>
                        </div>
                </div>    
            </div>