<!-- HISTÓRICO DE PROCESSOS -->

        <div class="main-content-title">
            <br><h2>Processos Associados</h2>
        </div>
            <div class="dynamic-content-edit">
                <div class="card-body">
                    {{#each erros}}
                        <div class="alert alert-danger">{{texto}}</div>
                    {{else}}
                    {{/each}}

                <table id="tabela" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>                            
                            <th scope="col">Processo</th>
                            <th scope="col">Autor</th>
                            <th scope="col">Réu</th>
                            <th scope="col">Status</th>
                            <th scope="col">Detalhes</th>
                            <th scope="col">Excluir</th>
                        </tr>        
                    </thead>
                    <tbody>
                        {{#each cliente.Processos}}
                        <tr>  
                            <td>{{Processo}}</td>
                            <td>{{Autor}}</td>
                            <td>{{Reu}}</td>
                            <td>{{Status}}</td>
                            <td onclick="window.location='/processo/detail/{{_id}}'"><i class="fa fa-search" style="color: #6e8efb; font-size: 20px;"></i></td>
                            <td onclick="window.location='/processo/deletar/{{_id}}'"><i class="fas fa-trash-alt" style="color: #6e8efb; font-size: 18px; "></i></td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
                    <div class="button-new" style="text-align: right">
                        <button type="submit" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#processoModal"><i class="fas fa-plus"></i><a href="/processo/triagem"></a></button>
                    </div>
                </div>
            </div>