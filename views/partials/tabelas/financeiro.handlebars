<!-- FINANCEIRO -->

        <div class="main-content-title">
            <br><h2>FINANCEIRO</h2>
        </div>
            <div class="dynamic-content-edit">
                <div class="card-body">
                    {{#each erros}}
                        <div class="alert alert-danger">{{texto}}</div>
                    {{else}}
                    {{/each}}
                <table id="tabela" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>                            
                            <th scope="col">Tipo</th>
                            <th scope="col">Vencimento</th>
                            <th scope="col">Honorários</th>
                            <th scope="col">Status</th>
                            <th scope="col">Atualizar</th>
                            <th scope="col">Excluir</th>
                        </tr>        
                    </thead>
                    <tbody>
                        {{#each processo.Financeiro}}
                        <tr>  
                            <td>{{Tipo}}</td>
                            <td>{{#formatDate Vencimento}}{{/formatDate}}</td>
                            <td>{{Honorarios}}</td>
                            <td>{{Status}}</td>
                            <td onclick0="window.location='/processo/detail/{{_id}}'"><i class="fa fa-search" style="color: grey; font-size: 20px;"></i></td>
                            <td onclick="window.location='/financeiro/deletar/{{_id}}'"><i class="fas fa-trash-alt" style="color: #6e8efb; font-size: 18px; "></i></td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
                    <div class="button-new" style="text-align: right">
                        <button type="submit" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#financeiroModal"><i class="fas fa-plus"></i><a href="#"></a></button>
                    </div>
                </div>
            </div>
