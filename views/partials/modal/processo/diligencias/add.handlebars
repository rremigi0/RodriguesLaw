<!-- Modal para Cadastrar Nova Diligência -->

    <div class="modal fade" id="diligenciaModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="dynamic-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cadastrar Diligência</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>      
                    </div>        
                    <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}
                        <form action="/diligencia/add" method="POST">
                            <div class="form-group">
                                <label for="processo">Código do Processo (Não alterar)</label><input type="text" class="form-control" id="processo" name="processo" value="{{processo.id}}">
                                <label for="numero">Número do Processo</label><input type="text" class="form-control" id="numero" name="numero" value="{{processo.Processo}}">
                                <label for="autor">Autor</label><input type="text" class="form-control" id="autor" name="autor" value="{{processo.Autor}}">
                                <label for="reu">Réu</label><input type="text" class="form-control" id="reu" name="reu" value="{{processo.Reu}}">
                                <label for="procedimento">Procedimento</label><input type="text" class="form-control" id="procedimento" name="procedimento" value="{{processo.Procedimento}}">
                                <label for="peticao">Petição Processual</label><input type="text" class="form-control" id="peticao" name="peticao">
                                <label for="prazo">Prazo</label><input type="date" class="form-control" id="prazo" name="prazo">
                                <label for="status">Status</label>
                                <select class="form-control" id="status" name="status">
                                    <option>Pendente</option>
                                </select>
                            </div>
                                <button type="submit" class="btn">Salvar</button>
                        </form>         
                    </div>
                </div>
            </div>
        </div>
    </div>