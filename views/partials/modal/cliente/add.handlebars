   <!-- Cadastro de Clientes (Modal Novo Cliente) -->
   
    <div class="modal fade" id="add" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="dynamic-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cadastrar Cliente</h5>
                        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>      
                    </div>        
                   <div class="card-body">
                        {{#each erros}}
                            <div class="alert alert-danger">{{texto}}</div>
                        {{else}}
                        {{/each}}

<!-- Menu de Navegação de Cadastro de Clientes -->

                        <form action="/cliente/add/addClientes" method="POST">
                            <nav>
                            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                                <a class="nav-item nav-link active" id="nav-geral-tab" data-toggle="tab" href="#nav-geral" role="tab" aria-controls="nav-geral" aria-selected="true">Geral</a>
                                <a class="nav-item nav-link" id="nav-documentos-tab" data-toggle="tab" href="#nav-documentos" role="tab" aria-controls="nav-documentos" aria-selected="false">Documentos</a>
                                <a class="nav-item nav-link" id="nav-endereco-tab" data-toggle="tab" href="#nav-endereco" role="tab" aria-controls="nav-endereco" aria-selected="false">Endereço</a>
                                <a class="nav-item nav-link" id="nav-contact-tab" data-toggle="tab" href="#nav-contact" role="tab" aria-controls="nav-contact" aria-selected="false">Contato</a>
                            </div>
                            </nav>

<!-- Aba Navegação Geral do Cadastro de Clientes -->

                            <div class="tab-content" id="nav-tabContent">
                                <div class="tab-pane fade show active" id="nav-geral" role="tabpanel" aria-labelledby="nav-geral-tab">
                                    <div class="card-body">    
                                        <div class="form-row">
                                            <div class="col-md-3 mb-3">
                                            <label for="codigo">Código*</label><input type="number" class="form-control" id="codigo" placeholder="01" name="codigo">
                                            </div>

                                            <div class="col-md-9 mb-9">
                                            <label for="nome">Nome*</label><input type="text" class="form-control" id="nome" placeholder="Digite o nome completo" name="nome">
                                            </div>
                                        </div>

                                        <div class="form-row">
                                            <div class="col-md-3 mb-3">
                                                <label for="nascimento">Nascimento</label><input type="text" class="form-control" id="nascimento" placeholder="__/__/____" name="nascimento">
                                            </div>

                                            <div class="col-md-3 mb-3">
                                                <label for="sexo">Sexo</label><select class="form-control" id="sexo" name="sexo">
                                                    <option>Feminino</option><option>Masculino</option><option>Não Especificado</option>
                                                </select>
                                            </div>

                                            <div class="col-md-3 mb-3">
                                                <label for="estado">Estado Civil</label><select class="form-control" id="estado" name="estado">
                                                    <option>Solteiro(a)</option><option>Casado(a)</option><option>Divorciado(a)</option><option>Viúvo(a)</option><option>União Estável</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="nacionalidade">Nacionalidade</label><input type="text" class="form-control" id="nacionalidade" placeholder="Ex.: Brasileiro" name="nacionalidade">
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="profissao">Profissão</label><input type="text" class="form-control" id="profissao" placeholder="Ex.: Engenheiro" name="profissao">
                                            </div>    
                                        </div>
                                    </div>    
                                </div>
    
<!-- Aba Navegação Documentos do Cadastro de Clientes -->

                                <div class="tab-pane fade" id="nav-documentos" role="tabpanel" aria-labelledby="nav-documentos-tab">
                                    <div class="card-body">
                                        <div class="form row">
                                            <div class="col-md-6 mb-6">
                                                <label for="cpf_cnpj">CPF/CNPJ*</label><input type="text" class="form-control" id="cpf_cnpj" placeholder="Digite o CPF ou CNPJ" name="cpf_cnpj">
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="identidade">Cédula de Identidade</label><input type="text" class="form-control" id="identidade" placeholder="Número" name="identidade">
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="expedicao">Órgão de Expedição</label><input type="text" class="form-control" id="expedicao" placeholder="Órgão Emissor" name="expedicao">
                                            </div>
                                        </div>
                                        <div class="form row">
                                            <div class="col-md-6 mb-6">
                                                <label for="pis">PIS/PASEP</label><input type="text" class="form-control" id="pis" placeholder="Digite o PIS/PASEP" name="pis">
                                            </div>
                                            <div class="col-md-2 mb-2">
                                                <label for="uf_id">UF</label><input type="text" class="form-control" id="uf_id" placeholder="UF" name="uf_id">
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="emissao_id">Emissão</label><input type="text" class="form-control" id="emissao_id" placeholder="__/__/____" name="emissao_id">
                                            </div>
                                        </div>
                                        <div class="form row">
                                            <div class="col-md-3 mb-3">
                                                <label for="ctps">Carteira de Trabalho</label><input type="text" class="form-control" id="ctps" placeholder="Número" name="ctps">
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="serie_ctps">Série</label><input type="text" class="form-control" id="serie_ctps" placeholder="Série" name="serie_ctps">
                                            </div>
                                            <div class="col-md-2 mb-2">
                                                <label for="uf_ctps">UF</label><input type="text" class="form-control" id="uf_ctps" placeholder="UF" name="uf_ctps">
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <label for="emissao_ctps">Emissão</label><input type="text" class="form-control" id="emissao_ctps" placeholder="__/__/____" name="emissao_ctps">
                                            </div>
                                        </div>
                                    </div>
                                </div>

<!-- Aba Navegação Endereço do Cadastro de Clientes -->

                                <div class="tab-pane fade" id="nav-endereco" role="tabpanel" aria-labelledby="nav-endereco-tab">
                                    <div class="card-body">
                                        <div class="form row">
                                            <div class="col-md-2 mb-2">
                                                <label for="tipo">Tipo</label><input type="text" class="form-control" id="tipo" placeholder="Ex.: Rua" name="tipo">
                                            </div>
                                            <div class="col-md-6 mb-6">
                                                <label for="endereco">Endereço</label><input type="text" class="form-control" id="endereco" placeholder="Digite o Endereço" name="endereco">
                                            </div>
                                            <div class="col-md-2 mb-2">
                                                <label for="numero">Número</label><input type="text" class="form-control" id="numero" placeholder="Número" name="numero">
                                            </div>
                                            <div class="col-md-2 mb-2">
                                                <label for="uf">UF</label><input type="text" class="form-control" id="uf" placeholder="UF" name="uf">
                                            </div>
                                        </div>
                                        <div class="form row">
                                            <div class="col-md-4 mb-4">
                                                <label for="complemento">Complemento</label><input type="text" class="form-control" id="complemento" placeholder="Digite o Complemento" name="complemento">
                                            </div>
                                            <div class="col-md-4 mb-4">
                                                <label for="bairro">Bairro</label><input type="text" class="form-control" placeholder="Digite o Bairro" id="bairro" name="bairro">
                                            </div>
                                            <div class="col-md-4 mb-4">
                                                <label for="cidade">Cidade</label><input type="text" class="form-control" id="municipio" placeholder="Digite a Cidade" name="municipio">
                                            </div>
                                        </div>
                                        <div class="form row">
                                            <div class="col-md-4 mb-4">
                                                <label for="cep">CEP</label><input type="text" class="form-control" id="cep" placeholder="CEP" name="cep"><br>
                                            </div>
                                        </div>
                                        </div>
                                    </div>
<!-- Aba Navegação Endereço do Cadastro de Clientes -->

                                <div class="tab-pane fade" id="nav-contact" role="tabpanel" aria-labelledby="nav-contact-tab">
                                    <div class="card-body">
                                        <div class="form row">
                                            <div class="col-md-6 mb-6">
                                                <label for="celualar">Celular</label><input type="text" class="form-control" id="celular" placeholder="(_._) 9. _._._._-_._._._" name="celular">
                                            </div>
                                            <div class="col-md-6 mb-6">
                                                <label for="email">Email</label><input type="email" class="form-control" id="email" placeholder="Digite o Email" name="email"><br>
                                            </div>
                                        </div>
                                        <button type="submit" class="btn">Salvar</button>
                                    </div>
                                </div>  
                        </form>
                    </div>
                </div>
            </div>
        </div>
